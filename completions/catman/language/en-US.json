{
  "meta": {
    "url": "https://gitlab.com/man-db/man-db",
    "description": [
      "Create or update preformatted manual pages."
    ]
  },
  "option": [
    {
      "name": "--config-file",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --config-file=FILE"
      ],
      "tip": [
        "Use this user configuration file."
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "Emit debugging messages."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-?"
      ],
      "usage": [
        "-?, --help"
      ],
      "tip": [
        "Give this help list."
      ]
    },
    {
      "name": "--manpath",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --manpath=PATH"
      ],
      "tip": [
        "Set the manual page search path."
      ],
      "next": []
    },
    {
      "name": "--usage",
      "tip": [
        "Give a short usage message."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print program version."
      ]
    }
  ]
}
