{
  "meta": {
    "url": "https://gitlab.com/lvmteam/lvm2",
    "description": [
      "更改卷组属性"
    ]
  },
  "option": [
    {
      "name": "--activate",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --activate y|n|ay"
      ],
      "tip": [
        "更改 LV 的活动状态。"
      ],
      "next": [
        {
          "name": "ay"
        },
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--activationmode",
      "usage": [
        "--activationmode partial|degraded|complete"
      ],
      "tip": [
        "决定 PV 缺失（例如设备故障）时是否允许激活 LV。"
      ],
      "next": [
        {
          "name": "complete"
        },
        {
          "name": "degraded"
        },
        {
          "name": "partial"
        }
      ]
    },
    {
      "name": "--addtag",
      "usage": [
        "--addtag Tag"
      ],
      "tip": [
        "为 PV、VG 或 LV 添加标签。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--alloc",
      "usage": [
        "--alloc contiguous|cling|cling_by_tags|normal|anywhere|inherit"
      ],
      "tip": [
        "决定命令从 VG 分配物理区段（PE）时使用的分配策略。"
      ],
      "next": [
        {
          "name": "anywhere"
        },
        {
          "name": "cling"
        },
        {
          "name": "cling_by_tags"
        },
        {
          "name": "contiguous"
        },
        {
          "name": "inherit"
        },
        {
          "name": "normal"
        }
      ]
    },
    {
      "name": "--autoactivation",
      "usage": [
        "--autoactivation String"
      ],
      "tip": [
        "指定是否从事件使用自动激活。"
      ],
      "next": []
    },
    {
      "name": "--autobackup",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --autobackup y|n"
      ],
      "tip": [
        "指定更改后是否自动备份元数据。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--commandprofile",
      "usage": [
        "--commandprofile String"
      ],
      "tip": [
        "用于命令配置的命令配置。"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config String"
      ],
      "tip": [
        "命令的配置设置。"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "设置调试级别。"
      ],
      "repeat": 6
    },
    {
      "name": "--deltag",
      "usage": [
        "--deltag Tag"
      ],
      "tip": [
        "从 PV、VG 或 LV 删除标签。"
      ],
      "next": []
    },
    {
      "name": "--detachprofile",
      "tip": [
        "从 VG 或 LV 分离元数据配置。"
      ]
    },
    {
      "name": "--devices",
      "usage": [
        "--devices PV"
      ],
      "tip": [
        "限制命令可见和可访问的设备。"
      ],
      "repeat": 99,
      "separator": ",",
      "next": []
    },
    {
      "name": "--devicesfile",
      "usage": [
        "--devicesfile String"
      ],
      "tip": [
        "LVM 应使用的设备列表文件。"
      ],
      "next": []
    },
    {
      "name": "--driverloaded",
      "usage": [
        "--driverloaded y|n"
      ],
      "tip": [
        "设为 no 时，命令不会尝试使用 device-mapper。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "覆盖各种检查、确认和保护。"
      ],
      "repeat": 99
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助文本。"
      ]
    },
    {
      "name": "--ignoreactivationskip",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --ignoreactivationskip"
      ],
      "tip": [
        "激活时忽略 LV 的 \"activation skip\" 标志，使带有该标志的 LV 也能被激活。"
      ]
    },
    {
      "name": "--ignorelockingfailure",
      "tip": [
        "允许命令在锁定失败后继续进行只读元数据操作。"
      ]
    },
    {
      "name": "--ignoremonitoring",
      "tip": [
        "除非指定 --monitor，否则不与 dmeventd 交互。"
      ]
    },
    {
      "name": "--journal",
      "usage": [
        "--journal String"
      ],
      "tip": [
        "将信息记录到 systemd 日志。"
      ],
      "next": []
    },
    {
      "name": "--lockopt",
      "usage": [
        "--lockopt String"
      ],
      "tip": [
        "用于向 lvmlockd 传递特殊情况选项。"
      ],
      "next": []
    },
    {
      "name": "--lockstart",
      "tip": [
        "在 lvmlockd 中启动共享 VG 的锁空间。"
      ]
    },
    {
      "name": "--lockstop",
      "tip": [
        "在 lvmlockd 中停止共享 VG 的锁空间。"
      ]
    },
    {
      "name": "--locktype",
      "usage": [
        "--locktype sanlock|dlm|none"
      ],
      "tip": [
        "将 VG 锁类型切换为 lvmlockd 使用的共享锁类型，或从该类型切回。"
      ],
      "next": [
        {
          "name": "dlm"
        },
        {
          "name": "none"
        },
        {
          "name": "sanlock"
        }
      ]
    },
    {
      "name": "--logicalvolume",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --logicalvolume Number"
      ],
      "tip": [
        "设置 VG 中允许的最大 LV 数。"
      ],
      "next": []
    },
    {
      "name": "--longhelp",
      "tip": [
        "显示长帮助文本。"
      ]
    },
    {
      "name": "--majoritypvs",
      "tip": [
        "当 VG 中多数 PV（超过半数）存在时更改 VG 系统 ID。"
      ]
    },
    {
      "name": "--maxphysicalvolumes",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --maxphysicalvolumes Number"
      ],
      "tip": [
        "设置可属于该 VG 的最大 PV 数。"
      ],
      "next": []
    },
    {
      "name": "--metadatacopies",
      "usage": [
        "--metadatacopies all|unmanaged|Number"
      ],
      "tip": [
        "保留的 VG 元数据副本数。"
      ],
      "next": []
    },
    {
      "name": "--metadataprofile",
      "usage": [
        "--metadataprofile String"
      ],
      "tip": [
        "用于命令配置的元数据配置。"
      ],
      "next": []
    },
    {
      "name": "--monitor",
      "usage": [
        "--monitor y|n"
      ],
      "tip": [
        "开始（yes）或停止（no）使用 dmeventd 监视 LV。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--nohints",
      "tip": [
        "不使用提示文件定位 PV 的设备。"
      ]
    },
    {
      "name": "--nolocking",
      "tip": [
        "禁用锁定。"
      ]
    },
    {
      "name": "--noudevsync",
      "tip": [
        "禁用 udev 同步。"
      ]
    },
    {
      "name": "--partial",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --partial"
      ],
      "tip": [
        "命令会尽力激活存在缺失 PV 区段的 LV。"
      ]
    },
    {
      "name": "--physicalextentsize",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --physicalextentsize Size[m|UNIT]"
      ],
      "tip": [
        "设置 VG 中 PV 的物理区段大小。"
      ],
      "next": []
    },
    {
      "name": "--poll",
      "usage": [
        "--poll y|n"
      ],
      "tip": [
        "为 yes 时，启动 LV 的后台转换。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--profile",
      "usage": [
        "--profile String"
      ],
      "tip": [
        "根据命令不同，作为 --commandprofile 或 --metadataprofile 的别名。"
      ],
      "next": []
    },
    {
      "name": "--pvmetadatacopies",
      "usage": [
        "--pvmetadatacopies 0|1|2"
      ],
      "tip": [
        "在 PV 上为存储 VG 元数据预留的元数据区数量。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制输出和日志消息。"
      ],
      "repeat": 99
    },
    {
      "name": "--readonly",
      "tip": [
        "阻止命令进行更改，包括激活和元数据更新。"
      ]
    },
    {
      "name": "--refresh",
      "tip": [
        "如果 LV 处于活动状态，则重新加载其元数据。"
      ]
    },
    {
      "name": "--reportformat",
      "usage": [
        "--reportformat basic|json|json_std"
      ],
      "tip": [
        "覆盖由 lvm.conf(5) 中 report/output_format 全局定义的报告输出格式。"
      ],
      "next": [
        {
          "name": "basic"
        },
        {
          "name": "json"
        },
        {
          "name": "json_std"
        }
      ]
    },
    {
      "name": "--resizeable",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --resizeable y|n"
      ],
      "tip": [
        "启用或禁用向 VG 添加或从 VG 移除 PV（通过 vgextend/vgreduce）。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--select",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --select String"
      ],
      "tip": [
        "根据指定条件选择要处理和报告的对象。"
      ],
      "next": []
    },
    {
      "name": "--setautoactivation",
      "usage": [
        "--setautoactivation y|n"
      ],
      "tip": [
        "设置 VG 或 LV 的自动激活属性。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--sysinit",
      "tip": [
        "表示 vgchange/lvchange 由早期系统初始化脚本（例如 rc.sysinit 或 initrd）在可写文件系统可用之前调用。"
      ]
    },
    {
      "name": "--systemid",
      "usage": [
        "--systemid String"
      ],
      "tip": [
        "更改 VG 的系统 ID。"
      ],
      "next": []
    },
    {
      "name": "--test",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --test"
      ],
      "tip": [
        "以测试模式运行。"
      ]
    },
    {
      "name": "--uuid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uuid String"
      ],
      "tip": [
        "为指定 VG 生成新的随机 UUID。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "设置详细级别。"
      ],
      "repeat": 99
    },
    {
      "name": "--version",
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--vgmetadatacopies",
      "usage": [
        "--vgmetadatacopies all|unmanaged|Number"
      ],
      "tip": [
        "保留的 VG 元数据副本数。"
      ],
      "next": []
    },
    {
      "name": "--yes",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yes"
      ],
      "tip": [
        "不进行交互确认，始终假定回答为 yes。"
      ]
    }
  ]
}
