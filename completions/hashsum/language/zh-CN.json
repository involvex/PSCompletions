{
  "meta": {
    "url": "https://github.com/uutils/coreutils",
    "description": [
      "计算并校验消息摘要。",
      "补全基于 [uutils/coreutils](https://github.com/uutils/coreutils) 编写。"
    ]
  },
  "option": [
    {
      "name": "--b2sum",
      "tip": [
        "使用 BLAKE2 算法"
      ]
    },
    {
      "name": "--b3sum",
      "tip": [
        "使用 BLAKE3 算法"
      ]
    },
    {
      "name": "--binary",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --binary"
      ],
      "tip": [
        "以二进制模式读取（默认）"
      ]
    },
    {
      "name": "--bits",
      "usage": [
        "--bits <BITS>"
      ],
      "tip": [
        "设置输出长度（仅适用于 SHAKE）"
      ],
      "next": []
    },
    {
      "name": "--check",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --check"
      ],
      "tip": [
        "从指定文件读取哈希值并校验"
      ]
    },
    {
      "name": "--ignore-missing",
      "tip": [
        "文件缺失时不报错，也不输出状态"
      ]
    },
    {
      "name": "--md5",
      "tip": [
        "使用 MD5 算法"
      ]
    },
    {
      "name": "--no-names",
      "tip": [
        "输出中省略文件名（GNU/Coreutils 中没有此选项）"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "每个文件校验成功时都不打印 OK"
      ]
    },
    {
      "name": "--sha1",
      "tip": [
        "使用 SHA1 算法"
      ]
    },
    {
      "name": "--sha224",
      "tip": [
        "使用 SHA224 算法"
      ]
    },
    {
      "name": "--sha256",
      "tip": [
        "使用 SHA256 算法"
      ]
    },
    {
      "name": "--sha3",
      "tip": [
        "使用 SHA3 算法"
      ]
    },
    {
      "name": "--sha3-224",
      "tip": [
        "使用 SHA3-224 算法"
      ]
    },
    {
      "name": "--sha3-256",
      "tip": [
        "使用 SHA3-256 算法"
      ]
    },
    {
      "name": "--sha3-384",
      "tip": [
        "使用 SHA3-384 算法"
      ]
    },
    {
      "name": "--sha3-512",
      "tip": [
        "使用 SHA3-512 算法"
      ]
    },
    {
      "name": "--sha384",
      "tip": [
        "使用 SHA384 算法"
      ]
    },
    {
      "name": "--sha512",
      "tip": [
        "使用 SHA512 算法"
      ]
    },
    {
      "name": "--shake128",
      "tip": [
        "使用 SHAKE128 算法，输出长度由 BITS 决定"
      ]
    },
    {
      "name": "--shake256",
      "tip": [
        "使用 SHAKE256 算法，输出长度由 BITS 决定"
      ]
    },
    {
      "name": "--status",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --status"
      ],
      "tip": [
        "不输出任何内容，成功与否由退出码表示"
      ]
    },
    {
      "name": "--strict",
      "tip": [
        "校验行格式不合法时返回非零退出码"
      ]
    },
    {
      "name": "--tag",
      "tip": [
        "生成 BSD 风格的校验和"
      ]
    },
    {
      "name": "--text",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --text"
      ],
      "tip": [
        "以文本模式读取"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--warn",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --warn"
      ],
      "tip": [
        "校验行格式不合法时给出警告"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "每行输出以 NUL 结尾，而不是换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
