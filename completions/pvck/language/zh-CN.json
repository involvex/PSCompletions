{
  "meta": {
    "url": "https://gitlab.com/lvmteam/lvm2",
    "description": [
      "检查物理卷上的元数据"
    ]
  },
  "option": [
    {
      "name": "--commandprofile",
      "usage": [
        "--commandprofile String"
      ],
      "tip": [
        "用于命令配置的命令配置。"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config String"
      ],
      "tip": [
        "命令的配置设置。"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "设置调试级别。"
      ],
      "repeat": 6
    },
    {
      "name": "--devices",
      "usage": [
        "--devices PV"
      ],
      "tip": [
        "限制命令可见和可访问的设备。"
      ],
      "repeat": 99,
      "separator": ",",
      "next": []
    },
    {
      "name": "--devicesfile",
      "usage": [
        "--devicesfile String"
      ],
      "tip": [
        "LVM 应使用的设备列表文件。"
      ],
      "next": []
    },
    {
      "name": "--driverloaded",
      "usage": [
        "--driverloaded y|n"
      ],
      "tip": [
        "设为 no 时，命令不会尝试使用 device-mapper。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--dump",
      "usage": [
        "--dump headers|metadata|metadata_all|metadata_search"
      ],
      "tip": [
        "输出 PV 的头部和元数据以进行调试和修复。"
      ],
      "next": [
        {
          "name": "headers"
        },
        {
          "name": "metadata"
        },
        {
          "name": "metadata_all"
        },
        {
          "name": "metadata_search"
        }
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file String"
      ],
      "tip": [
        "要读取或写入的元数据文件。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助文本。"
      ]
    },
    {
      "name": "--journal",
      "usage": [
        "--journal String"
      ],
      "tip": [
        "将信息记录到 systemd 日志。"
      ],
      "next": []
    },
    {
      "name": "--labelsector",
      "usage": [
        "--labelsector Number"
      ],
      "tip": [
        "默认在 PV 的第二个扇区（扇区 1）写入 LVM2 标识。"
      ],
      "next": []
    },
    {
      "name": "--lockopt",
      "usage": [
        "--lockopt String"
      ],
      "tip": [
        "用于向 lvmlockd 传递特殊情况选项。"
      ],
      "next": []
    },
    {
      "name": "--longhelp",
      "tip": [
        "显示长帮助文本。"
      ]
    },
    {
      "name": "--metadatacopies",
      "usage": [
        "--metadatacopies 0|1|2"
      ],
      "tip": [
        "在 PV 上为存储 VG 元数据预留的元数据区数量。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--nohints",
      "tip": [
        "不使用提示文件定位 PV 的设备。"
      ]
    },
    {
      "name": "--nolocking",
      "tip": [
        "禁用锁定。"
      ]
    },
    {
      "name": "--profile",
      "usage": [
        "--profile String"
      ],
      "tip": [
        "根据命令不同，作为 --commandprofile 或 --metadataprofile 的别名。"
      ],
      "next": []
    },
    {
      "name": "--pvmetadatacopies",
      "usage": [
        "--pvmetadatacopies 0|1|2"
      ],
      "tip": [
        "在 PV 上为存储 VG 元数据预留的元数据区数量。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制输出和日志消息。"
      ],
      "repeat": 99
    },
    {
      "name": "--repair",
      "tip": [
        "修复 PV 上的头部和元数据。"
      ]
    },
    {
      "name": "--repairtype",
      "usage": [
        "--repairtype pv_header|metadata|label_header"
      ],
      "tip": [
        "修复 PV 上的头部和元数据。"
      ],
      "next": [
        {
          "name": "label_header"
        },
        {
          "name": "metadata"
        },
        {
          "name": "pv_header"
        }
      ]
    },
    {
      "name": "--settings",
      "usage": [
        "--settings String"
      ],
      "tip": [
        "以 \"Key = Value\" 形式指定命令特定设置。"
      ],
      "next": []
    },
    {
      "name": "--test",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --test"
      ],
      "tip": [
        "以测试模式运行。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "设置详细级别。"
      ],
      "repeat": 99
    },
    {
      "name": "--version",
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--yes",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yes"
      ],
      "tip": [
        "不进行交互确认，始终假定回答为 yes。"
      ]
    }
  ]
}
