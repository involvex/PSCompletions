{
  "meta": {
    "url": "https://www.gnu.org/software/binutils",
    "description": [
      "Generate an index to speed access to archives."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print this help message."
      ]
    },
    {
      "name": "--plugin",
      "usage": [
        "--plugin <name>"
      ],
      "tip": [
        "Load the specified plugin."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Print version information."
      ]
    },
    {
      "name": "-D",
      "tip": [
        "Use zero for the symbol map timestamp (default)."
      ]
    },
    {
      "name": "-t",
      "tip": [
        "Update the archive's symbol map timestamp."
      ]
    },
    {
      "name": "-U",
      "tip": [
        "Use the actual symbol map timestamp."
      ]
    }
  ]
}
