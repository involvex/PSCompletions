{
  "meta": {
    "url": "https://gitlab.com/procps-ng/procps",
    "description": [
      "查找正在运行程序的进程 ID。"
    ]
  },
  "option": [
    {
      "name": "-c",
      "tip": [
        "仅返回具有相同根目录的进程。"
      ]
    },
    {
      "name": "-d",
      "usage": [
        "-d sep"
      ],
      "tip": [
        "使用 sep 作为输出分隔符。"
      ],
      "next": []
    },
    {
      "name": "-h",
      "tip": [
        "显示用法信息。"
      ]
    },
    {
      "name": "-n",
      "tip": [
        "避免对网络文件系统上的二进制文件执行 stat。"
      ]
    },
    {
      "name": "-o",
      "usage": [
        "-o omitpid"
      ],
      "tip": [
        "忽略此 PID 的进程。",
        "使用 %PPID 表示父进程。"
      ],
      "next": []
    },
    {
      "name": "-q",
      "tip": [
        "不显示匹配的 PID；仅设置退出状态。"
      ]
    },
    {
      "name": "-s",
      "tip": [
        "仅返回一个 PID。"
      ]
    },
    {
      "name": "-x",
      "tip": [
        "同时返回运行指定脚本的 shell。"
      ]
    },
    {
      "name": "-z",
      "tip": [
        "同时检测卡在僵尸状态的进程。"
      ]
    }
  ]
}
