              "tip": [
                "向实验添加注释标签（最多 10 个）。"
              ],
              "next": []
            },
            {
              "name": "-F",
              "usage": [
                "-F {off|on|=<regex>}"
              ],
              "tip": [
                "控制是否跟随后代进程。"
              ],
              "next": [
                {
                  "name": "off"
                },
                {
                  "name": "on"
                }
              ]
            },
            {
              "name": "-h",
              "usage": [
                "-h {<ctr_def>...,<ctr_n_def>}"
