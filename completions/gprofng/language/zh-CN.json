{
  "meta": {
    "url": "https://www.gnu.org/software/binutils",
    "description": [
      "gprofng 性能分析工具的驱动程序。"
    ]
  },
  "next": [
    {
      "name": "archive",
      "tip": [
        "将二进制文件和源代码包含到实验目录中。"
      ],
      "option": [
        {
          "name": "--help",
          "tip": [
            "打印用法信息并退出。"
          ]
        },
        {
          "name": "--verbose",
          "usage": [
            "--verbose {on|off}"
          ],
          "tip": [
            "启用或禁用详细模式（默认关闭）。"
          ],
          "next": [
            {
              "name": "off"
            },
            {
              "name": "on"
            }
          ]
        },
        {
          "name": "--version",
          "tip": [
            "打印版本号并退出。"
          ]
        },
        {
          "name": "-a",
          "usage": [
            "-a {off|on|ldobjects|src|usedldobjects|usedsrc}"
          ],
          "tip": [
            "选择要归档的二进制文件和源文件。"
          ],
          "next": [
            {
              "name": "ldobjects"
            },
            {
              "name": "off"
            },
            {
              "name": "on"
            },
            {
              "name": "src"
            },
            {
              "name": "usedldobjects"
            },
            {
              "name": "usedsrc"
            }
          ]
        },
        {
          "name": "-d",
          "usage": [
            "-d <path>"
          ],
          "tip": [
            "设置公共归档目录的位置。"
          ],
          "next": []
        },
        {
          "name": "-F",
          "tip": [
            "强制写入或重写归档。"
          ]
        },
        {
          "name": "-m",
          "usage": [
            "-m <regex>"
          ],
          "tip": [
            "仅归档完整路径匹配 POSIX 正则的文件。"
          ],
          "next": []
        },
        {
          "name": "-n",
          "tip": [
            "仅归档指定实验，不包括其后代。"
          ]
        },
        {
          "name": "-q",
          "tip": [
            "不向标准错误写入警告。"
          ]
        }
      ]
    },
    {
      "name": "collect",
      "tip": [
        "收集性能数据。"
      ],
      "next": [
        {
          "name": "app",
          "tip": [
            "收集应用程序性能数据。"
          ],
          "option": [
            {
              "name": "--help",
              "tip": [
                "打印用法信息并退出。"
              ]
            },
            {
              "name": "--verbose",
              "usage": [
                "--verbose {on|off}"
              ],
              "tip": [
                "启用或禁用详细模式（默认关闭）。"
              ],
              "next": [
                {
                  "name": "off"
                },
                {
                  "name": "on"
                }
              ]
            },
            {
              "name": "--version",
              "tip": [
                "打印版本号并退出。"
              ]
            },
            {
              "name": "-a",
              "usage": [
                "-a {off|on|ldobjects|src|usedldobjects|usedsrc}"
              ],
              "tip": [
                "控制二进制文件和源文件的归档。"
              ],
              "next": [
                {
                  "name": "ldobjects"
                },
                {
                  "name": "off"
                },
                {
                  "name": "on"
                },
                {
                  "name": "src"
                },
                {
                  "name": "usedldobjects"
                },
                {
                  "name": "usedsrc"
                }
              ]
