              "tip": [
                "启用硬件事件计数器性能分析并选择计数器。",
                "不带其他参数使用 -h 可列出支持的计数器。"
              ],
              "next": []
            },
            {
              "name": "-H",
              "usage": [
                "-H {off|on|N1[-N2]}"
              ],
              "tip": [
                "控制堆跟踪或设置堆数据收集范围。"
              ],
              "next": [
                {
                  "name": "off"
                },
                {
                  "name": "on"
                }
              ]
            },
            {
              "name": "-i",
              "usage": [
                "-i {off|on}"
              ],
              "tip": [
                "启用或禁用 I/O 跟踪。"
              ],
              "next": [
                {
                  "name": "off"
                },
                {
                  "name": "on"
                }
              ]
            },
            {
              "name": "-j",
              "usage": [
                "-j {on|off|<path>}"
              ],
              "tip": [
                "启用或禁用 Java 性能分析，可指定 JVM 路径。"
              ],
              "next": [
                {
                  "name": "off"
                },
                {
                  "name": "on"
                }
              ]
            },
            {
              "name": "-J",
              "usage": [
                "-J <java-args>"
              ],
              "tip": [
                "指定传递给 JVM 的参数。"
              ],
              "next": []
            },
            {
              "name": "-l",
              "usage": [
                "-l <signal>"
              ],
              "tip": [
                "指定触发资源利用率采样的信号。"
              ],
              "next": []
            },
            {
              "name": "-n",
              "tip": [
                "试运行：显示运行时设置但不运行目标。"
              ]
            },
            {
              "name": "-o",
              "usage": [
                "-o <exp_name>"
              ],
              "tip": [
                "设置实验目录的名称和路径。"
              ],
              "next": []
            },
            {
              "name": "-O",
              "usage": [
                "-O <exp_name>"
              ],
              "tip": [
                "类似 -o，但静默覆盖现有实验目录。"
              ],
              "next": []
            },
            {
              "name": "-p",
              "usage": [
                "-p {off|on|lo|hi|<value>}"
              ],
              "tip": [
                "控制时钟性能分析，或以毫秒设置采样粒度。"
              ],
              "next": [
                {
                  "name": "hi"
                },
                {
                  "name": "lo"
                },
                {
                  "name": "off"
                },
                {
                  "name": "on"
                }
              ]
            },
            {
              "name": "-s",
              "usage": [
                "-s <option>[,<API>]"
              ],
              "tip": [
                "启用同步等待跟踪；API 为 n、j 或 nj。"
              ],
              "next": []
            },
            {
              "name": "-S",
              "usage": [
                "-S {off|on|<seconds>}"
              ],
              "tip": [
                "控制进程范围资源利用率的周期性采样。"
              ],
              "next": [
                {
                  "name": "off"
                },
                {
                  "name": "on"
                }
              ]
            },
            {
              "name": "-t",
              "usage": [
                "-t <duration>[m|s]"
              ],
              "tip": [
                "以秒或分钟设置记录持续时间。"
              ],
              "next": []
            },
            {
              "name": "-y",
              "usage": [
                "-y <signal>[,r]"
              ],
              "tip": [
                "设置延迟初始化和暂停/恢复信号。"
              ],
              "next": []
            }
          ]
        }
