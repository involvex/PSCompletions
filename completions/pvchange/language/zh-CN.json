{
  "meta": {
    "url": "https://gitlab.com/lvmteam/lvm2",
    "description": [
      "更改物理卷属性"
    ]
  },
  "option": [
    {
      "name": "--addtag",
      "usage": [
        "--addtag Tag"
      ],
      "tip": [
        "为 PV、VG 或 LV 添加标签。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "更改所有可见的 PV。"
      ]
    },
    {
      "name": "--allocatable",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --allocatable y|n"
      ],
      "tip": [
        "启用或禁用此 PV 上的物理区段分配。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--autobackup",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --autobackup y|n"
      ],
      "tip": [
        "指定更改后是否自动备份元数据。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--commandprofile",
      "usage": [
        "--commandprofile String"
      ],
      "tip": [
        "用于命令配置的命令配置。"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config String"
      ],
      "tip": [
        "命令的配置设置。"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "设置调试级别。"
      ],
      "repeat": 6
    },
    {
      "name": "--deltag",
      "usage": [
        "--deltag Tag"
      ],
      "tip": [
        "从 PV、VG 或 LV 删除标签。"
      ],
      "next": []
    },
    {
      "name": "--devices",
      "usage": [
        "--devices PV"
      ],
      "tip": [
        "限制命令可见和可访问的设备。"
      ],
      "repeat": 99,
      "separator": ",",
      "next": []
    },
    {
      "name": "--devicesfile",
      "usage": [
        "--devicesfile String"
      ],
      "tip": [
        "LVM 应使用的设备列表文件。"
      ],
      "next": []
    },
    {
      "name": "--driverloaded",
      "usage": [
        "--driverloaded y|n"
      ],
      "tip": [
        "设为 no 时，命令不会尝试使用 device-mapper。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "覆盖各种检查、确认和保护。"
      ],
      "repeat": 99
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助文本。"
      ]
    },
    {
      "name": "--journal",
      "usage": [
        "--journal String"
      ],
      "tip": [
        "将信息记录到 systemd 日志。"
      ],
      "next": []
    },
    {
      "name": "--lockopt",
      "usage": [
        "--lockopt String"
      ],
      "tip": [
        "用于向 lvmlockd 传递特殊情况选项。"
      ],
      "next": []
    },
    {
      "name": "--longhelp",
      "tip": [
        "显示长帮助文本。"
      ]
    },
    {
      "name": "--metadataignore",
      "usage": [
        "--metadataignore y|n"
      ],
      "tip": [
        "指定 PV 的 metadataignore 属性。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--nohints",
      "tip": [
        "不使用提示文件定位 PV 的设备。"
      ]
    },
    {
      "name": "--nolocking",
      "tip": [
        "禁用锁定。"
      ]
    },
    {
      "name": "--profile",
      "usage": [
        "--profile String"
      ],
      "tip": [
        "根据命令不同，作为 --commandprofile 或 --metadataprofile 的别名。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制输出和日志消息。"
      ],
      "repeat": 99
    },
    {
      "name": "--reportformat",
      "usage": [
        "--reportformat basic|json|json_std"
      ],
      "tip": [
        "覆盖由 lvm.conf(5) 中 report/output_format 全局定义的报告输出格式。"
      ],
      "next": [
        {
          "name": "basic"
        },
        {
          "name": "json"
        },
        {
          "name": "json_std"
        }
      ]
    },
    {
      "name": "--select",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --select String"
      ],
      "tip": [
        "根据指定条件选择要处理和报告的对象。"
      ],
      "next": []
    },
    {
      "name": "--test",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --test"
      ],
      "tip": [
        "以测试模式运行。"
      ]
    },
    {
      "name": "--uuid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uuid String"
      ],
      "tip": [
        "为指定 PV 生成新的随机 UUID。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "设置详细级别。"
      ],
      "repeat": 99
    },
    {
      "name": "--version",
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--yes",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yes"
      ],
      "tip": [
        "不进行交互确认，始终假定回答为 yes。"
      ]
    }
  ]
}
