{
  "meta": {
    "url": "https://github.com/sysstat/sysstat",
    "description": [
      "Report CPU statistics."
    ]
  },
  "option": [
    {
      "name": "--dec",
      "usage": [
        "--dec={0|1|2}"
      ],
      "tip": [
        "Set the decimal precision."
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--human",
      "tip": [
        "Print sizes in human-readable format."
      ]
    },
    {
      "name": "--pretty",
      "tip": [
        "Pretty-print JSON output."
      ]
    },
    {
      "name": "-A",
      "tip": [
        "Display all statistics."
      ]
    },
    {
      "name": "-h",
      "tip": [
        "Print sizes in human-readable format."
      ]
    },
    {
      "name": "-H",
      "tip": [
        "Display the timestamp in ISO format."
      ]
    },
    {
      "name": "-I",
      "usage": [
        "-I {SUM|CPU|SCPU|ALL}"
      ],
      "tip": [
        "Display interrupt statistics."
      ],
      "next": [
        {
          "name": "ALL"
        },
        {
          "name": "CPU"
        },
        {
          "name": "SCPU"
        },
        {
          "name": "SUM"
        }
      ]
    },
    {
      "name": "-k",
      "tip": [
        "Display sizes in kilobytes."
      ]
    },
    {
      "name": "-m",
      "tip": [
        "Display sizes in megabytes."
      ]
    },
    {
      "name": "-n",
      "tip": [
        "Display per-node statistics."
      ]
    },
    {
      "name": "-N",
      "usage": [
        "-N {<node_list>|ALL}"
      ],
      "tip": [
        "Display statistics for nodes."
      ],
      "next": [
        {
          "name": "ALL"
        }
      ]
    },
    {
      "name": "-o",
      "usage": [
        "-o JSON"
      ],
      "tip": [
        "Output in JSON format."
      ],
      "next": [
        {
          "name": "JSON"
        }
      ]
    },
    {
      "name": "-P",
      "usage": [
        "-P {<cpu_list>|ALL}"
      ],
      "tip": [
        "Display statistics for CPUs."
      ],
      "next": [
        {
          "name": "ALL"
        }
      ]
    },
    {
      "name": "-t",
      "tip": [
        "Display timestamps."
      ]
    },
    {
      "name": "-T",
      "tip": [
        "Display topology information."
      ]
    },
    {
      "name": "-u",
      "tip": [
        "Display CPU utilization."
      ]
    },
    {
      "name": "-V",
      "tip": [
        "Print version information."
      ]
    }
  ]
}
