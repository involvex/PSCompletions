{
  "meta": {
    "url": "https://gitlab.com/lvmteam/lvm2",
    "description": [
      "将物理卷移入新的或现有卷组"
    ]
  },
  "option": [
    {
      "name": "--alloc",
      "usage": [
        "--alloc contiguous|cling|cling_by_tags|normal|anywhere|inherit"
      ],
      "tip": [
        "决定命令从 VG 分配物理区段（PE）时使用的分配策略。"
      ],
      "next": [
        {
          "name": "anywhere"
        },
        {
          "name": "cling"
        },
        {
          "name": "cling_by_tags"
        },
        {
          "name": "contiguous"
        },
        {
          "name": "inherit"
        },
        {
          "name": "normal"
        }
      ]
    },
    {
      "name": "--autobackup",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --autobackup y|n"
      ],
      "tip": [
        "指定更改后是否自动备份元数据。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--commandprofile",
      "usage": [
        "--commandprofile String"
      ],
      "tip": [
        "用于命令配置的命令配置。"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config String"
      ],
      "tip": [
        "命令的配置设置。"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "设置调试级别。"
      ],
      "repeat": 6
    },
    {
      "name": "--devices",
      "usage": [
        "--devices PV"
      ],
      "tip": [
        "限制命令可见和可访问的设备。"
      ],
      "repeat": 99,
      "separator": ",",
      "next": []
    },
    {
      "name": "--devicesfile",
      "usage": [
        "--devicesfile String"
      ],
      "tip": [
        "LVM 应使用的设备列表文件。"
      ],
      "next": []
    },
    {
      "name": "--driverloaded",
      "usage": [
        "--driverloaded y|n"
      ],
      "tip": [
        "设为 no 时，命令不会尝试使用 device-mapper。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助文本。"
      ]
    },
    {
      "name": "--journal",
      "usage": [
        "--journal String"
      ],
      "tip": [
        "将信息记录到 systemd 日志。"
      ],
      "next": []
    },
    {
      "name": "--lockopt",
      "usage": [
        "--lockopt String"
      ],
      "tip": [
        "用于向 lvmlockd 传递特殊情况选项。"
      ],
      "next": []
    },
    {
      "name": "--longhelp",
      "tip": [
        "显示长帮助文本。"
      ]
    },
    {
      "name": "--maxlogicalvolumes",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --maxlogicalvolumes Number"
      ],
      "tip": [
        "设置 VG 中允许的最大 LV 数。"
      ],
      "next": []
    },
    {
      "name": "--maxphysicalvolumes",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --maxphysicalvolumes Number"
      ],
      "tip": [
        "设置可属于该 VG 的最大 PV 数。"
      ],
      "next": []
    },
    {
      "name": "--metadatacopies",
      "usage": [
        "--metadatacopies all|unmanaged|Number"
      ],
      "tip": [
        "保留的 VG 元数据副本数。"
      ],
      "next": []
    },
    {
      "name": "--metadatatype",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --metadatatype lvm2"
      ],
      "tip": [
        "指定要使用的磁盘元数据类型。"
      ],
      "next": []
    },
    {
      "name": "--name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --name String"
      ],
      "tip": [
        "仅移动指定 LV 使用的 PV。"
      ],
      "next": []
    },
    {
      "name": "--nohints",
      "tip": [
        "不使用提示文件定位 PV 的设备。"
      ]
    },
    {
      "name": "--nolocking",
      "tip": [
        "禁用锁定。"
      ]
    },
    {
      "name": "--poolmetadataspare",
      "usage": [
        "--poolmetadataspare y|n"
      ],
      "tip": [
        "启用或禁用 VG 中备用池元数据 LV 的自动创建和管理。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--profile",
      "usage": [
        "--profile String"
      ],
      "tip": [
        "根据命令不同，作为 --commandprofile 或 --metadataprofile 的别名。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制输出和日志消息。"
      ],
      "repeat": 99
    },
    {
      "name": "--test",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --test"
      ],
      "tip": [
        "以测试模式运行。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "设置详细级别。"
      ],
      "repeat": 99
    },
    {
      "name": "--version",
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--vgmetadatacopies",
      "usage": [
        "--vgmetadatacopies all|unmanaged|Number"
      ],
      "tip": [
        "保留的 VG 元数据副本数。"
      ],
      "next": []
    },
    {
      "name": "--yes",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yes"
      ],
      "tip": [
        "不进行交互确认，始终假定回答为 yes。"
      ]
    }
  ]
}
