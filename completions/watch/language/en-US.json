{
  "meta": {
    "url": "https://gitlab.com/procps-ng/procps",
    "description": [
      "Execute a program periodically and show its output."
    ]
  },
  "option": [
    {
      "name": "--beep",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --beep"
      ],
      "tip": [
        "Beep if the command has a non-zero exit."
      ]
    },
    {
      "name": "--chgexit",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --chgexit"
      ],
      "tip": [
        "Exit when the output from the command changes."
      ]
    },
    {
      "name": "--color",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --color"
      ],
      "tip": [
        "Interpret ANSI color and style sequences."
      ]
    },
    {
      "name": "--differences",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --differences[=<permanent>]"
      ],
      "tip": [
        "Highlight changes between updates.",
        "Use --differences=permanent for the permanent form."
      ],
      "next": []
    },
    {
      "name": "--equexit",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --equexit <cycles>"
      ],
      "tip": [
        "Exit when the output does not change for the given cycles."
      ],
      "next": []
    },
    {
      "name": "--errexit",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --errexit"
      ],
      "tip": [
        "Exit if the command has a non-zero exit."
      ]
    },
    {
      "name": "--exec",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exec"
      ],
      "tip": [
        "Pass the command to exec instead of sh -c."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help and exit."
      ]
    },
    {
      "name": "--interval",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --interval <secs>"
      ],
      "tip": [
        "Seconds to wait between updates."
      ],
      "next": []
    },
    {
      "name": "--no-color",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --no-color"
      ],
      "tip": [
        "Do not interpret ANSI color and style sequences."
      ]
    },
    {
      "name": "--no-rerun",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --no-rerun"
      ],
      "tip": [
        "Do not rerun the program on window resize."
      ]
    },
    {
      "name": "--no-title",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --no-title"
      ],
      "tip": [
        "Turn off the header."
      ]
    },
    {
      "name": "--no-wrap",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --no-wrap"
      ],
      "tip": [
        "Turn off line wrapping."
      ]
    },
    {
      "name": "--precise",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --precise"
      ],
      "tip": [
        "Attempt to run the command at precise intervals."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Output version information and exit."
      ]
    }
  ]
}
