{
  "meta": {
    "url": "https://github.com/iproute2/iproute2",
    "description": [
      "Print network interface statistics."
    ]
  },
  "option": [
    {
      "name": "--errors",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --errors"
      ],
      "tip": [
        "Show errors."
      ]
    },
    {
      "name": "--extended",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --extended=TYPE"
      ],
      "tip": [
        "Show extended statistics of the type.",
        "Possible values: cpu_hits"
      ],
      "next": [
        {
          "name": "cpu_hits"
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show a summary of options."
      ]
    },
    {
      "name": "--ignore",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --ignore"
      ],
      "tip": [
        "Ignore the history file."
      ]
    },
    {
      "name": "--interval",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --interval=SECS"
      ],
      "tip": [
        "Report the average over the last SECS seconds."
      ],
      "next": []
    },
    {
      "name": "--json",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --json"
      ],
      "tip": [
        "Display results in JSON."
      ]
    },
    {
      "name": "--nooutput",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nooutput"
      ],
      "tip": [
        "Update the history file without displaying output."
      ]
    },
    {
      "name": "--noupdate",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --noupdate"
      ],
      "tip": [
        "Do not update the history file."
      ]
    },
    {
      "name": "--pretty",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pretty"
      ],
      "tip": [
        "Pretty-print JSON output."
      ]
    },
    {
      "name": "--reset",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reset"
      ],
      "tip": [
        "Reset history."
      ]
    },
    {
      "name": "--scan",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --scan=SECS"
      ],
      "tip": [
        "Sample statistics every SECS seconds."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the program version."
      ]
    },
    {
      "name": "--zeros",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zeros"
      ],
      "tip": [
        "Show entries with zero activity."
      ]
    }
  ]
}
