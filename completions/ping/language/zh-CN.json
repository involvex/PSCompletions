    "description": [
      "向网络主机发送 ICMP ECHO_REQUEST。"
    ]
  },
  "option": [
    {
      "name": "-3",
      "tip": [
        "使用不向上取整的 RTT 精度。"
      ]
    },
    {
      "name": "-4",
      "tip": [
        "使用 IPv4。"
      ]
    },
    {
      "name": "-6",
      "tip": [
        "使用 IPv6。"
      ]
    },
    {
      "name": "-a",
      "tip": [
        "使用可听 ping。"
      ]
    },
    {
      "name": "-A",
      "tip": [
        "使用自适应 ping。"
      ]
    },
    {
