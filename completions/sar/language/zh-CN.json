{
  "meta": {
    "url": "https://github.com/sysstat/sysstat",
    "description": [
      "收集、报告或保存系统活动信息。"
    ]
  },
  "option": [
    {
      "name": "--dec",
      "usage": [
        "--dec={0|1|2}"
      ],
      "tip": [
        "设置小数精度。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--human",
      "tip": [
        "以人类可读格式打印大小。"
      ]
    },
    {
      "name": "--pretty",
      "tip": [
        "美化 JSON 输出。"
      ]
    },
    {
      "name": "-A",
      "tip": [
        "报告所有统计。"
      ]
    },
    {
