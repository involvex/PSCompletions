{
  "meta": {
    "url": "https://gitlab.com/psmisc/psmisc",
    "description": [
      "Print information about a process."
    ]
  },
  "option": [
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Raw display of information."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version information and exit."
      ]
    }
  ]
}
