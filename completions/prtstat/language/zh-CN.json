{
  "meta": {
    "url": "https://gitlab.com/psmisc/psmisc",
    "description": [
      "打印进程信息。"
    ]
  },
  "option": [
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "原始信息显示。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息并退出。"
      ]
    }
  ]
}
