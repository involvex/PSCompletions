{
  "meta": {
    "url": "https://android.googlesource.com/platform/system/core/+/refs/heads/main/fastboot",
    "description": [
      "fastboot is a command-line tool for flashing partitions on Android devices.",
      "It communicates with a device in bootloader mode via USB or network."
    ]
  },
  "next": [
    {
      "name": "boot",
      "usage": [
        "boot KERNEL [RAMDISK [SECOND]]"
      ],
      "tip": [
        "Download and boot kernel from RAM."
      ],
      "option": [
        {
          "name": "--base",
          "usage": [
            "--base ADDRESS"
          ],
          "tip": [
            "Set kernel base address (default: 0x10000000)."
          ]
        },
        {
          "name": "--cmdline",
          "usage": [
            "--cmdline CMDLINE"
          ],
          "tip": [
            "Override kernel command line."
          ]
        },
        {
          "name": "--dtb",
          "usage": [
            "--dtb DTB"
          ],
          "tip": [
            "Specify path to DTB for boot image header version 2."
          ]
        },
        {
          "name": "--dtb-offset",
          "usage": [
            "--dtb-offset OFFSET"
          ],
          "tip": [
            "Set dtb offset (default: 0x01100000)."
          ]
        },
        {
          "name": "--header-version",
          "usage": [
            "--header-version VERSION"
          ],
          "tip": [
            "Set boot image header version."
          ]
        },
        {
          "name": "--kernel-offset",
          "usage": [
            "--kernel-offset OFFSET"
          ],
          "tip": [
            "Set kernel offset (default: 0x00008000)."
          ]
        },
        {
          "name": "--os-patch-level",
          "usage": [
            "--os-patch-level YYYY-MM-DD"
          ],
          "tip": [
            "Set boot image OS security patch level."
          ]
        },
        {
          "name": "--os-version",
          "usage": [
            "--os-version MAJOR[.MINOR[.PATCH]]"
          ],
          "tip": [
            "Set boot image OS version (default: 0.0.0)."
          ]
        },
        {
          "name": "--page-size",
          "usage": [
            "--page-size BYTES"
          ],
          "tip": [
            "Set flash page size (default: 2048)."
          ]
        },
        {
          "name": "--ramdisk-offset",
          "usage": [
            "--ramdisk-offset OFFSET"
          ],
          "tip": [
            "Set ramdisk offset (default: 0x01000000)."
          ]
        },
        {
          "name": "--tags-offset",
          "usage": [
            "--tags-offset OFFSET"
          ],
          "tip": [
            "Set tags offset (default: 0x00000100)."
          ]
        }
      ]
    },
    {
      "name": "create-logical-partition",
      "usage": [
        "create-logical-partition NAME SIZE"
      ],
      "tip": [
        "Create a logical partition with the given name and",
        "size, in the super partition."
      ]
    },
    {
      "name": "delete-logical-partition",
      "usage": [
        "delete-logical-partition NAME"
      ],
      "tip": [
        "Delete a logical partition with the given name."
      ]
    },
    {
      "name": "devices",
      "usage": [
        "devices [-l]"
      ],
      "tip": [
        "List devices in bootloader (-l: with device paths)."
      ],
      "option": [
        {
          "name": "-l",
          "tip": [
            "List devices with device paths."
          ]
        }
      ]
    },
    {
      "name": "erase",
      "usage": [
        "erase PARTITION"
      ],
      "tip": [
        "Erase a flash partition."
      ]
    },
    {
      "name": "fetch",
      "usage": [
        "fetch PARTITION OUT_FILE"
      ],
      "tip": [
        "Fetch a partition image from the device."
      ]
    },
    {
      "name": "flash",
      "usage": [
        "flash PARTITION [FILENAME]"
      ],
      "tip": [
        "Flash given partition, using the image from",
        "$ANDROID_PRODUCT_OUT if no filename is given."
      ],
      "option": [
        {
          "name": "--dtb",
          "usage": [
            "--dtb DTB"
          ],
          "tip": [
            "If set with flash vendor_boot:RAMDISK, then",
            "update the vendor_boot image with provided DTB."
          ]
        }
      ]
    },
    {
      "name": "flash:raw",
      "usage": [
        "flash:raw PARTITION KERNEL [RAMDISK [SECOND]]"
      ],
      "tip": [
        "Create boot image and flash it."
      ],
      "option": [
        {
          "name": "--base",
          "usage": [
            "--base ADDRESS"
          ],
          "tip": [
            "Set kernel base address (default: 0x10000000)."
          ]
        },
        {
          "name": "--cmdline",
          "usage": [
            "--cmdline CMDLINE"
          ],
          "tip": [
            "Override kernel command line."
          ]
        },
        {
          "name": "--dtb",
          "usage": [
            "--dtb DTB"
          ],
          "tip": [
            "Specify path to DTB for boot image header version 2."
          ]
        },
        {
          "name": "--dtb-offset",
          "usage": [
            "--dtb-offset OFFSET"
          ],
          "tip": [
            "Set dtb offset (default: 0x01100000)."
          ]
        },
        {
          "name": "--header-version",
          "usage": [
            "--header-version VERSION"
          ],
          "tip": [
            "Set boot image header version."
          ]
        },
        {
          "name": "--kernel-offset",
          "usage": [
            "--kernel-offset OFFSET"
          ],
          "tip": [
            "Set kernel offset (default: 0x00008000)."
          ]
        },
        {
          "name": "--os-patch-level",
          "usage": [
            "--os-patch-level YYYY-MM-DD"
          ],
          "tip": [
            "Set boot image OS security patch level."
          ]
        },
        {
          "name": "--os-version",
          "usage": [
            "--os-version MAJOR[.MINOR[.PATCH]]"
          ],
          "tip": [
            "Set boot image OS version (default: 0.0.0)."
          ]
        },
        {
          "name": "--page-size",
          "usage": [
            "--page-size BYTES"
          ],
          "tip": [
            "Set flash page size (default: 2048)."
          ]
        },
        {
          "name": "--ramdisk-offset",
          "usage": [
            "--ramdisk-offset OFFSET"
          ],
          "tip": [
            "Set ramdisk offset (default: 0x01000000)."
          ]
        },
        {
          "name": "--tags-offset",
          "usage": [
            "--tags-offset OFFSET"
          ],
          "tip": [
            "Set tags offset (default: 0x00000100)."
          ]
        }
      ]
    },
    {
      "name": "flashall",
      "tip": [
        "Flash all partitions from $ANDROID_PRODUCT_OUT.",
        "On A/B devices, flashed slot is set as active.",
        "Secondary images may be flashed to inactive slot."
      ]
    },
    {
      "name": "flashing",
      "usage": [
        "flashing lock|unlock"
      ],
      "tip": [
        "Lock/unlock partitions for flashing."
      ],
      "option": [
        {
          "name": "get_unlock_ability",
          "tip": [
            "Check whether unlocking is allowed (1) or not (0)."
          ]
        },
        {
          "name": "lock",
          "tip": [
            "Lock partitions for flashing."
          ]
        },
        {
          "name": "lock_critical",
          "tip": [
            "Lock 'critical' bootloader partitions."
          ]
        },
        {
          "name": "unlock",
          "tip": [
            "Unlock partitions for flashing."
          ]
        },
        {
          "name": "unlock_critical",
          "tip": [
            "Unlock 'critical' bootloader partitions."
          ]
        }
      ]
    },
    {
      "name": "format",
      "usage": [
        "format[:FS_TYPE[:SIZE]] PARTITION"
      ],
      "tip": [
        "Format a flash partition."
      ]
    },
    {
      "name": "get_staged",
      "usage": [
        "get_staged OUT_FILE"
      ],
      "tip": [
        "Writes data staged by the last command to a file."
      ]
    },
    {
      "name": "getvar",
      "usage": [
        "getvar NAME"
      ],
      "tip": [
        "Display given bootloader variable."
      ]
    },
    {
      "name": "gsi",
      "usage": [
        "gsi wipe|disable|status"
      ],
      "tip": [
        "Wipe, disable or show status of a GSI installation",
        "(fastbootd only)."
      ],
      "option": [
        {
          "name": "disable",
          "tip": [
            "Disable GSI installation."
          ]
        },
        {
          "name": "status",
          "tip": [
            "Show status of GSI installation."
          ]
        },
        {
          "name": "wipe",
          "tip": [
            "Wipe GSI installation."
          ]
        }
      ]
    },
    {
      "name": "oem",
      "usage": [
        "oem [COMMAND...]"
      ],
      "tip": [
        "Execute OEM-specific command."
      ]
    },
    {
      "name": "reboot",
      "usage": [
        "reboot [bootloader]"
      ],
      "tip": [
        "Reboot device."
      ]
    },
    {
      "name": "resize-logical-partition",
      "usage": [
        "resize-logical-partition NAME SIZE"
      ],
      "tip": [
        "Change the size of the named logical partition."
      ]
    },
    {
      "name": "set_active",
      "usage": [
        "set_active SLOT"
      ],
      "tip": [
        "Set the active slot."
      ]
    },
    {
      "name": "snapshot-update",
      "usage": [
        "snapshot-update cancel|merge"
      ],
      "tip": [
        "On devices that support snapshot-based updates, cancel",
        "an in-progress update or merge if in the 'merging' phase."
      ],
      "option": [
        {
          "name": "cancel",
          "tip": [
            "Cancel an in-progress snapshot update.",
            "This may make the device unbootable until it is reflashed."
          ]
        },
        {
          "name": "merge",
          "tip": [
            "Finish an in-progress update if it is in the",
            "'merging' phase."
          ]
        }
      ]
    },
    {
      "name": "stage",
      "usage": [
        "stage IN_FILE"
      ],
      "tip": [
        "Sends given file to stage for the next command."
      ]
    },
    {
      "name": "update",
      "usage": [
        "update ZIP"
      ],
      "tip": [
        "Flash all partitions from an update.zip package."
      ]
    },
    {
      "name": "wipe-super",
      "usage": [
        "wipe-super [SUPER_EMPTY]"
      ],
      "tip": [
        "Wipe the super partition. This will reset it to",
        "contain an empty set of default dynamic partitions."
      ]
    }
  ],
  "option": [
    {
      "name": "--disable-fastboot-info",
      "tip": [
        "Will collects tasks from image list rather than",
        "$OUT/fastboot-info.txt."
      ]
    },
    {
      "name": "--disable-super-optimization",
      "tip": [
        "Disables optimizations on flashing super partition."
      ]
    },
    {
      "name": "--disable-verification",
      "tip": [
        "Sets disable-verification when flashing vbmeta."
      ]
    },
    {
      "name": "--disable-verity",
      "tip": [
        "Sets disable-verity when flashing vbmeta."
      ]
    },
    {
      "name": "--exclude-dynamic-partitions",
      "tip": [
        "Excludes flashing of dynamic partitions."
      ]
    },
    {
      "name": "--force",
      "tip": [
        "Force a flash operation that may be unsafe."
      ]
    },
    {
      "name": "--fs-options",
      "usage": [
        "--fs-options=OPTION[,OPTION]"
      ],
      "tip": [
        "Enable filesystem features.",
        "OPTION supports casefold, projid, compress."
      ]
    },
    {
      "name": "--set-active",
      "usage": [
        "--set-active[=SLOT]"
      ],
      "tip": [
        "Sets the active slot before rebooting."
      ]
    },
    {
      "name": "--skip-reboot",
      "tip": [
        "Don't reboot device after flashing."
      ]
    },
    {
      "name": "--skip-secondary",
      "tip": [
        "Don't flash secondary slots in flashall/update."
      ]
    },
    {
      "name": "--slot",
      "usage": [
        "--slot SLOT"
      ],
      "tip": [
        "Use SLOT; 'all' for both slots, 'other' for",
        "non-current slot (default: current active slot)."
      ]
    },
    {
      "name": "--unbuffered",
      "tip": [
        "Don't buffer input or output."
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "Verbose output."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "-s",
      "usage": [
        "-s SERIAL",
        "-s tcp|udp:HOST[:PORT]"
      ],
      "tip": [
        "Specify a USB device.",
        "Specify a network device."
      ]
    },
    {
      "name": "-S",
      "usage": [
        "-S SIZE[K|M|G]"
      ],
      "tip": [
        "Break into sparse files no larger than SIZE."
      ]
    },
    {
      "name": "-v",
      "tip": [
        "Verbose output."
      ]
    },
    {
      "name": "-w",
      "tip": [
        "Wipe userdata."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "Show this message."
      ]
    },
    {
      "name": "-h",
      "tip": [
        "Show this message."
      ]
    }
  ]
}
