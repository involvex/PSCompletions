{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "处理系统密码请求。"
    ]
  },
  "option": [
    {
      "name": "--console",
      "usage": [
        "--console[=DEVICE]"
      ],
      "tip": [
        "在 /dev/console 或指定设备上询问。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--list",
      "tip": [
        "显示待处理的密码请求。"
      ]
    },
    {
      "name": "--plymouth",
      "tip": [
        "使用 Plymouth 而不是 TTY 询问。"
      ]
    },
    {
      "name": "--query",
      "tip": [
        "处理待处理的密码请求。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "--wall",
      "tip": [
        "持续将请求转发到 wall。"
      ]
    },
    {
      "name": "--watch",
      "tip": [
        "持续处理密码请求。"
      ]
    }
  ]
}
