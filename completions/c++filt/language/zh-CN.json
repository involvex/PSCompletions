{
  "meta": {
    "url": "https://www.gnu.org/software/binutils",
    "description": [
      "解码 C++ 和 Java 符号。"
    ]
  },
  "option": [
    {
      "name": "--format",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --format {none,auto,gnu-v3,java,gnat,dlang,rust}"
      ],
      "tip": [
        "选择解码风格。",
        "可能值: none, auto, gnu-v3, java, gnat, dlang, rust"
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "dlang"
        },
        {
          "name": "gnat"
        },
        {
          "name": "gnu-v3"
        },
        {
          "name": "java"
        },
        {
          "name": "none"
        },
        {
          "name": "rust"
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此信息。"
      ]
    },
    {
      "name": "--no-params",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --no-params"
      ],
      "tip": [
        "不显示函数参数。"
      ]
    },
    {
      "name": "--no-recurse-limit",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --no-recurse-limit"
      ],
      "tip": [
        "禁用解码递归限制。"
      ]
    },
    {
      "name": "--no-strip-underscore",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-strip-underscore"
      ],
      "tip": [
        "不忽略前导下划线（默认）。"
      ]
    },
    {
      "name": "--no-verbose",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --no-verbose"
      ],
      "tip": [
        "不显示实现细节。"
      ]
    },
    {
      "name": "--recurse-limit",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recurse-limit"
      ],
      "tip": [
        "启用解码递归限制（默认）。"
      ]
    },
    {
      "name": "--strip-underscore",
      "alias": [
        "-_"
      ],
      "usage": [
        "-_, --strip-underscore"
      ],
      "tip": [
        "忽略第一个前导下划线。"
      ]
    },
    {
      "name": "--types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --types"
      ],
      "tip": [
        "同时尝试解码类型编码。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
