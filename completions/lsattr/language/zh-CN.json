{
  "meta": {
    "url": "https://e2fsprogs.sourceforge.net",
    "description": [
      "列出 ext2/ext3/ext4 文件系统的文件属性。"
    ]
  },
  "option": [
    {
      "name": "-a",
      "tip": [
        "列出所有文件，包括隐藏文件。"
      ]
    },
    {
      "name": "-d",
      "tip": [
        "像其他文件一样列出目录，而不是列出其内容。"
      ]
    },
    {
      "name": "-l",
      "tip": [
        "使用长名称打印属性。"
      ]
    },
    {
      "name": "-p",
      "tip": [
        "列出文件的项目号。"
      ]
    },
    {
      "name": "-R",
      "tip": [
        "递归列出目录及其内容的属性。"
      ]
    },
    {
      "name": "-v",
      "tip": [
        "列出文件的版本/生成号。"
      ]
    },
    {
      "name": "-V",
      "tip": [
        "显示程序版本。"
      ]
    }
  ]
}
