{
  "meta": {
    "url": "https://gitlab.com/man-db/man-db",
    "description": [
      "显示 man-db 数据库内容。"
    ]
  },
  "option": [
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "输出调试消息。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-?"
      ],
      "usage": [
        "-?, --help"
      ],
      "tip": [
        "给出此帮助列表。"
      ]
    },
    {
      "name": "--usage",
      "tip": [
        "给出简短用法消息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印程序版本。"
      ]
    }
  ]
}
