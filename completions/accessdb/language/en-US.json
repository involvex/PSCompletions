{
  "meta": {
    "url": "https://gitlab.com/man-db/man-db",
    "description": [
      "Display the contents of a man-db database."
    ]
  },
  "option": [
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "Emit debugging messages."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-?"
      ],
      "usage": [
        "-?, --help"
      ],
      "tip": [
        "Give this help list."
      ]
    },
    {
      "name": "--usage",
      "tip": [
        "Give a short usage message."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print program version."
      ]
    }
  ]
}
