{
  "meta": {
    "url": "https://github.com/sysstat/sysstat",
    "description": [
      "报告 Linux 任务统计信息。"
    ]
  },
  "option": [
    {
      "name": "--dec",
      "usage": [
        "--dec={0|1|2}"
      ],
      "tip": [
        "设置小数精度。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--human",
      "tip": [
        "以人类可读格式打印大小。"
      ]
    },
    {
      "name": "--pretty",
      "tip": [
        "美化 JSON 输出。"
      ]
    },
    {
      "name": "-C",
      "usage": [
        "-C <command>"
      ],
      "tip": [
        "仅报告具有此命令名的任务。"
      ],
      "next": []
    },
    {
      "name": "-d",
      "tip": [
        "报告 I/O 统计。"
      ]
    },
    {
      "name": "-G",
      "usage": [
        "-G <process_name>"
      ],
      "tip": [
        "仅报告具有此进程名的任务。"
      ],
      "next": []
    },
    {
      "name": "-h",
      "tip": [
        "以人类可读格式打印大小。"
      ]
    },
    {
      "name": "-H",
      "tip": [
        "以 ISO 格式显示时间戳。"
      ]
    },
    {
      "name": "-I",
      "tip": [
        "显示线程数。"
      ]
    },
    {
      "name": "-k",
      "tip": [
        "以千字节显示大小。"
      ]
    },
    {
      "name": "-l",
      "tip": [
        "显示命令名。"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "以兆字节显示大小。"
      ]
    },
    {
      "name": "-o",
      "usage": [
        "-o JSON"
      ],
      "tip": [
        "以 JSON 格式输出。"
      ],
      "next": [
        {
          "name": "JSON"
        }
      ]
    },
    {
      "name": "-p",
      "usage": [
        "-p {<pid> [...]|SELF|ALL}"
      ],
      "tip": [
        "仅报告这些 PID。"
      ],
      "next": [
        {
          "name": "ALL"
        },
        {
          "name": "SELF"
        }
      ]
    },
    {
      "name": "-r",
      "tip": [
        "报告页错误统计。"
      ]
    },
    {
      "name": "-R",
      "tip": [
        "报告内存页错误统计。"
      ]
    },
    {
      "name": "-s",
      "tip": [
        "报告栈使用情况。"
      ]
    },
    {
      "name": "-t",
      "tip": [
        "显示线程统计。"
      ]
    },
    {
      "name": "-T",
      "usage": [
        "-T {TASK|CHILD|ALL}"
      ],
      "tip": [
        "报告任务、子进程或两者。"
      ],
      "next": [
        {
          "name": "ALL"
        },
        {
          "name": "CHILD"
        },
        {
          "name": "TASK"
        }
      ]
    },
    {
      "name": "-u",
      "tip": [
        "报告 CPU 利用率。"
      ]
    },
    {
      "name": "-U",
      "usage": [
        "-U [<username>]"
      ],
      "tip": [
        "显示真实用户名。"
      ],
      "next": []
    },
    {
      "name": "-v",
      "tip": [
        "报告任务统计。"
      ]
    },
    {
      "name": "-V",
      "tip": [
        "打印版本信息。"
      ]
    },
    {
      "name": "-w",
      "tip": [
        "报告任务切换统计。"
      ]
    }
  ]
}
