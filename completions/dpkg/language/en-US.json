{
  "meta": {
    "url": "https://wiki.debian.org/Teams/Dpkg",
    "description": [
      "Debian package manager."
    ]
  },
  "option": [
    {
      "name": "--abort-after",
      "usage": [
        "--abort-after <n>"
      ],
      "tip": [
        "Abort after n errors."
      ],
      "next": []
    },
    {
      "name": "--add-architecture",
      "usage": [
        "--add-architecture <arch>"
      ],
      "tip": [
        "Add an architecture."
      ],
      "next": []
    },
    {
      "name": "--admindir",
      "usage": [
        "--admindir=<directory>"
      ],
      "tip": [
        "Use the directory instead of /var/lib/dpkg."
      ],
      "next": []
    },
    {
      "name": "--assert-help",
      "tip": [
        "Show help on assertions."
      ]
    },
    {
      "name": "--audit",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --audit [<package>...]"
      ],
      "tip": [
        "Check for broken packages."
      ],
      "next": []
    },
    {
      "name": "--auto-deconfigure",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --auto-deconfigure"
      ],
      "tip": [
        "Install even if it breaks another package."
      ]
    },
    {
      "name": "--clear-avail",
      "tip": [
        "Erase available package info."
      ]
    },
    {
      "name": "--clear-selections",
      "tip": [
        "Deselect every non-essential package."
      ]
    },
    {
      "name": "--compare-versions",
      "usage": [
        "--compare-versions <a> <op> <b>"
      ],
      "tip": [
        "Compare version numbers."
      ],
      "next": []
    },
    {
      "name": "--configure",
      "usage": [
        "--configure <package>..."
      ],
      "tip": [
        "Configure unpacked packages."
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --debug=<octal>"
      ],
      "tip": [
        "Enable debugging (see --debug=help)."
