      "name": "--skip-same-version",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --skip-same-version"
      ],
      "tip": [
        "Skip packages with the same version."
      ]
    },
    {
      "name": "--status",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --status [<package>...]"
      ],
      "tip": [
        "Display package status details."
      ],
      "next": []
    },
    {
      "name": "--status-fd",
      "usage": [
        "--status-fd <n>"
      ],
      "tip": [
        "Send status updates to the file descriptor."
      ],
      "next": []
    },
