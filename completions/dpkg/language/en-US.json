      "name": "--status-logger",
      "usage": [
        "--status-logger=<command>"
      ],
      "tip": [
        "Send status updates to the command's stdin."
      ],
      "next": []
    },
    {
      "name": "--triggers",
      "tip": [
        "Process consequential triggers."
      ]
    },
    {
      "name": "--triggers-only",
      "usage": [
        "--triggers-only <package>..."
      ],
      "tip": [
        "Process triggers only."
      ],
      "next": []
    },
    {
      "name": "--unpack",
      "usage": [
        "--unpack <.deb file>..."
      ],
      "tip": [
        "Unpack packages without configuring."
      ],
      "next": []
    },
    {
      "name": "--update-avail",
      "usage": [
        "--update-avail [<Packages-file>]"
      ],
      "tip": [
        "Replace available package info."
      ],
      "next": []
    },
    {
      "name": "--verify",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --verify [<package>...]"
      ],
      "tip": [
        "Verify package integrity."
      ],
      "next": []
    },
    {
      "name": "--verify-format",
      "usage": [
        "--verify-format=<format>"
      ],
      "tip": [
        "Set the verify output format (rpm)."
      ],
      "next": [
        {
          "name": "rpm"
        }
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show the version."
      ]
    },
    {
      "name": "--yet-to-unpack",
      "tip": [
        "Print packages selected for installation."
      ]
    }
