      "name": "--purge",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --purge <package>..."
      ],
      "tip": [
        "Purge packages and configuration."
      ],
      "next": []
    },
    {
      "name": "--record-avail",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --record-avail <.deb file>..."
      ],
      "tip": [
        "Record available package information."
      ],
      "next": []
    },
    {
      "name": "--refuse-downgrade",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --refuse-downgrade"
      ],
      "tip": [
        "Skip packages with earlier versions."
      ]
    },
    {
      "name": "--remove",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --remove <package>..."
      ],
      "tip": [
        "Remove packages."
      ],
      "next": []
    },
    {
      "name": "--remove-architecture",
      "usage": [
        "--remove-architecture <arch>"
      ],
      "tip": [
        "Remove an architecture."
      ],
      "next": []
    },
    {
      "name": "--robot",
      "tip": [
        "Use machine-readable output."
      ]
    },
    {
      "name": "--root",
      "usage": [
        "--root=<directory>"
      ],
      "tip": [
        "Install on a different root directory."
      ],
      "next": []
    },
    {
      "name": "--search",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --search <pattern>..."
      ],
      "tip": [
        "Find packages owning files."
      ],
      "next": []
    },
