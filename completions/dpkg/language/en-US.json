    {
      "name": "--path-include",
      "usage": [
        "--path-include=<pattern>"
      ],
      "tip": [
        "Re-include a previously excluded pattern."
      ],
      "next": []
    },
    {
      "name": "--post-invoke",
      "usage": [
        "--post-invoke=<command>"
      ],
      "tip": [
        "Set a post-invoke hook."
      ],
      "next": []
    },
    {
      "name": "--pre-invoke",
      "usage": [
        "--pre-invoke=<command>"
      ],
      "tip": [
        "Set a pre-invoke hook."
      ],
      "next": []
    },
