{
  "meta": {
    "url": "https://e2fsprogs.sourceforge.net",
    "description": [
      "Manage ext4 file system encryption."
    ]
  },
  "next": [
    {
      "name": "add_key",
      "usage": [
        "add_key -S salt [-k keyring] [-v] [-q] [-p pad] [path...]"
      ],
      "tip": [
        "Add a key to a keyring, optionally setting directory policies."
      ],
      "option": [
        {
          "name": "-k",
          "usage": [
            "-k keyring"
          ],
          "tip": [
            "Specify the keyring to add the key to."
          ],
          "next": []
        },
        {
          "name": "-p",
          "usage": [
            "-p pad"
          ],
          "tip": [
            "Set the directory-name padding.",
            "Possible values: 4, 8, 16, 32"
          ],
          "next": [
            {
              "name": "16"
            },
            {
              "name": "32"
            },
            {
              "name": "4"
            },
            {
              "name": "8"
            }
          ]
        },
        {
          "name": "-q",
          "tip": [
            "Quiet mode."
          ]
        },
        {
          "name": "-S",
          "usage": [
            "-S salt"
          ],
          "tip": [
            "Specify the salt used to derive the encryption key."
          ],
          "next": []
        },
        {
          "name": "-v",
          "tip": [
            "Verbose mode."
          ]
        }
      ]
    },
    {
      "name": "get_policy",
      "usage": [
        "get_policy path..."
      ],
      "tip": [
        "Print the encryption policy of the directories."
      ]
    },
    {
      "name": "new_session",
      "tip": [
        "Give the invoking process a new session keyring."
      ]
    },
    {
      "name": "set_policy",
      "usage": [
        "set_policy [-p pad] policy path..."
      ],
      "tip": [
        "Set the encryption policy of empty directories."
      ],
      "option": [
        {
          "name": "-p",
          "usage": [
            "-p pad"
          ],
          "tip": [
            "Set the directory-name padding.",
            "Possible values: 4, 8, 16, 32"
          ],
          "next": [
            {
              "name": "16"
            },
            {
              "name": "32"
            },
            {
              "name": "4"
            },
            {
              "name": "8"
            }
          ]
        }
      ]
    }
  ]
}
