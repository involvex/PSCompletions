{
  "meta": {
    "url": "https://github.com/iproute2/iproute2",
    "description": [
      "显示内核 SNMP 计数器和网络接口统计信息。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助信息。"
      ]
    },
    {
      "name": "--ignore",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --ignore"
      ],
      "tip": [
        "忽略历史并显示绝对值。"
      ]
    },
    {
      "name": "--interval",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --interval=SECS"
      ],
      "tip": [
        "对最近 SECS 秒取平均。"
      ],
      "next": []
    },
    {
      "name": "--json",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --json"
      ],
      "tip": [
        "以 JSON 格式输出。"
      ]
    },
    {
      "name": "--nooutput",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nooutput"
      ],
      "tip": [
        "仅更新历史，不显示内容。"
      ]
    },
    {
      "name": "--noupdate",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --noupdate"
      ],
      "tip": [
        "不更新历史。"
      ]
    },
    {
      "name": "--pretty",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pretty"
      ],
      "tip": [
        "美化 JSON 输出。"
      ]
    },
    {
      "name": "--reset",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reset"
      ],
      "tip": [
        "重置历史。"
      ]
    },
    {
      "name": "--scan",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --scan=SECS"
      ],
      "tip": [
        "每 SECS 秒采样一次统计信息。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "输出版本信息。"
      ]
    },
    {
      "name": "--zeros",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zeros"
      ],
      "tip": [
        "显示零活动条目。"
      ]
    }
  ]
}
