{
  "meta": {
    "url": "https://github.com/kmod-project/kmod",
    "description": [
      "Add and remove modules from the Linux kernel."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Consider every non-option argument as a module name."
      ]
    },
    {
      "name": "--config",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --config=FILE"
      ],
      "tip": [
        "Use the configuration file."
      ],
      "next": []
    },
    {
      "name": "--dirname",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dirname=DIR"
      ],
      "tip": [
        "Use DIR as the /lib/modules root."
      ],
      "next": []
    },
    {
      "name": "--dry-run",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --show, --dry-run"
      ],
      "tip": [
        "Print operations without executing them."
      ]
    },
    {
      "name": "--dump-modversions",
      "usage": [
        "--dump-modversions <filename>"
      ],
      "tip": [
        "Dump module versions from the file."
      ],
      "next": []
    },
    {
      "name": "--first-time",
      "tip": [
        "Fail if the module is already inserted or removed."
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "Force insertion or removal."
      ]
    },
    {
      "name": "--force-modversion",
      "tip": [
        "Ignore the module's version."
      ]
    },
    {
      "name": "--force-vermagic",
      "tip": [
        "Ignore the module's version magic."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--ignore-install",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-remove, --ignore-install"
      ],
      "tip": [
        "Ignore install or remove commands."
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Disable messages."
      ]
    },
    {
      "name": "--remove",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --remove"
      ],
      "tip": [
        "Remove modules instead of inserting them."
      ]
    },
    {
      "name": "--remove-dependencies",
      "tip": [
        "Deprecated: use --remove-holders."
      ]
    },
    {
      "name": "--remove-holders",
      "tip": [
        "Also remove module holders (with -r)."
      ]
    },
    {
      "name": "--resolve-alias",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --resolve-alias"
      ],
      "tip": [
        "Only look up and print the alias."
      ]
    },
    {
      "name": "--set-version",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --set-version=VERSION"
      ],
      "tip": [
        "Use VERSION instead of uname -r."
      ],
      "next": []
    },
    {
      "name": "--show-depends",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --show-depends"
      ],
      "tip": [
        "Only print module dependencies."
      ]
    },
    {
      "name": "--show-exports",
      "tip": [
        "Print module exported symbol versions."
      ]
    },
    {
      "name": "--show-modversions",
      "tip": [
        "Dump module symbol versions."
      ]
    },
    {
      "name": "--showconfig",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --showconfig, --show-config"
      ],
      "tip": [
        "Print known configuration and exit."
      ]
    },
    {
      "name": "--syslog",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --syslog"
      ],
      "tip": [
        "Print to syslog instead of stderr."
      ]
    },
    {
      "name": "--use-blacklist",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --use-blacklist"
      ],
      "tip": [
        "Apply the blacklist to a resolved alias."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Enable more messages."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    },
    {
      "name": "--wait",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wait=<MSEC>"
      ],
      "tip": [
        "Wait for the module refcount to become zero."
      ],
      "next": []
    }
  ]
}
