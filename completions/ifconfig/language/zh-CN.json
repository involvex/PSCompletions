{
  "meta": {
    "url": "https://sourceforge.net/projects/net-tools",
    "description": [
      "配置网络接口。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "在某些错误情况下输出更多信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-a",
      "tip": [
        "显示所有接口，包括已关闭的接口。"
      ]
    },
    {
      "name": "-allmulti",
      "tip": [
        "禁用全多播模式。"
      ]
    },
    {
      "name": "-arp",
      "tip": [
        "在此接口上禁用 ARP 协议。"
      ]
    },
    {
      "name": "-broadcast",
      "tip": [
        "清除广播标志。"
      ]
    },
    {
      "name": "-dynamic",
      "tip": [
        "清除接口的动态标志。"
      ]
    },
    {
      "name": "-pointopoint",
      "tip": [
        "禁用点对点模式。"
      ]
    },
    {
      "name": "-promisc",
      "tip": [
        "禁用混杂模式。"
      ]
    },
    {
      "name": "-s",
      "tip": [
        "显示简短列表（类似 netstat -i）。"
      ]
    },
    {
      "name": "-trailers",
      "tip": [
        "禁用尾部封装。"
      ]
    },
    {
      "name": "add",
      "usage": [
        "add <ADDRESS>[/<PREFIXLEN>]"
      ],
      "tip": [
        "向接口添加 IPv6 地址。"
      ],
      "next": []
    },
    {
      "name": "allmulti",
      "tip": [
        "启用全多播模式。"
      ]
    },
    {
      "name": "arp",
      "tip": [
        "在此接口上启用 ARP 协议。"
      ]
    },
    {
      "name": "ash",
      "tip": [
        "使用 ash 地址族。"
      ]
    },
    {
      "name": "ax25",
      "tip": [
        "使用 ax25 地址族。"
      ]
    },
    {
      "name": "broadcast",
      "usage": [
        "broadcast [<ADDRESS>]"
      ],
      "tip": [
        "设置广播地址，或设置广播标志。"
      ],
      "next": []
    },
    {
      "name": "ddp",
      "tip": [
        "使用 ddp 地址族。"
      ]
    },
    {
      "name": "del",
      "usage": [
        "del <ADDRESS>[/<PREFIXLEN>]"
      ],
      "tip": [
        "从接口移除 IPv6 地址。"
      ],
      "next": []
    },
    {
      "name": "down",
      "tip": [
        "关闭接口。"
      ]
    },
    {
      "name": "dstaddr",
      "usage": [
        "dstaddr <ADDRESS>"
      ],
      "tip": [
        "设置点对点链路的远端 IP 地址（已过时，请使用 pointopoint）。"
      ],
      "next": []
    },
    {
      "name": "dynamic",
      "tip": [
        "将接口标记为动态创建。"
      ]
