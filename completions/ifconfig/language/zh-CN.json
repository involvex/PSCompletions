      "name": "inet",
      "tip": [
        "使用 inet 地址族。"
      ]
    },
    {
      "name": "inet6",
      "tip": [
        "使用 inet6 地址族。"
      ]
    },
    {
      "name": "io_addr",
      "usage": [
        "io_addr <ADDRESS>"
      ],
      "tip": [
        "设置此设备的 I/O 空间起始地址。"
      ],
      "next": []
    },
    {
      "name": "ipx",
      "tip": [
        "使用 ipx 地址族。"
      ]
