    {
      "name": "irq",
      "usage": [
        "irq <ADDRESS>"
      ],
      "tip": [
        "设置此设备使用的中断线。"
      ],
      "next": []
    },
    {
      "name": "keepalive",
      "usage": [
        "keepalive <NN>"
      ],
      "tip": [
        "设置 SLIP 设备的 keepalive 值。"
