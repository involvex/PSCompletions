{
  "meta": {
    "url": "https://www.gnu.org/software/binutils",
    "description": [
      "Convert addresses into line number and file name pairs."
    ]
  },
  "option": [
    {
      "name": "--addresses",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --addresses"
      ],
      "tip": [
        "Show addresses."
      ]
    },
    {
      "name": "--basenames",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --basenames"
      ],
      "tip": [
        "Strip directory names."
      ]
    },
    {
      "name": "--demangle",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --demangle[=style]"
      ],
      "tip": [
        "Demangle function names."
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "dlang"
        },
        {
          "name": "gnat"
        },
        {
          "name": "gnu-v3"
        },
        {
          "name": "java"
        },
        {
          "name": "none"
        },
        {
          "name": "rust"
        }
      ]
    },
    {
      "name": "--exe",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exe=<executable>"
      ],
      "tip": [
        "Set the input file name (default a.out)."
      ],
      "next": []
    },
    {
      "name": "--functions",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --functions"
      ],
      "tip": [
        "Show function names."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this information."
      ]
    },
    {
      "name": "--inlines",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inlines"
      ],
      "tip": [
        "Unwind inlined functions."
      ]
    },
    {
      "name": "--no-recurse-limit",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --no-recurse-limit"
      ],
      "tip": [
        "Disable the recursion limit while demangling."
      ]
    },
    {
      "name": "--pretty-print",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pretty-print"
      ],
      "tip": [
        "Make the output easier to read for humans."
      ]
    },
    {
      "name": "--recurse-limit",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recurse-limit"
      ],
      "tip": [
        "Enable a recursion limit while demangling (default)."
      ]
    },
    {
      "name": "--section",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --section=<name>"
      ],
      "tip": [
        "Read section-relative offsets instead of addresses."
      ],
      "next": []
    },
    {
      "name": "--target",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --target=<bfdname>"
      ],
      "tip": [
        "Set the binary file format."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Display the program version."
      ]
    }
  ]
}
