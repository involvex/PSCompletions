{
  "meta": {
    "url": "https://gitlab.com/man-db/man-db",
    "description": [
      "显示手册页。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "查找所有匹配的手册页。"
      ]
    },
    {
      "name": "--apropos",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --apropos"
      ],
      "tip": [
        "等同于 apropos。"
      ]
    },
    {
      "name": "--ascii",
      "alias": [
        "-7"
      ],
      "usage": [
        "-7, --ascii"
      ],
      "tip": [
        "显示 ASCII 转换。"
      ]
    },
    {
      "name": "--catman",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --catman"
      ],
      "tip": [
        "重新格式化过期的 cat 页。"
      ]
    },
    {
      "name": "--config-file",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --config-file=FILE"
      ],
      "tip": [
        "使用此用户配置文件。"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "输出调试消息。"
      ]
    },
    {
      "name": "--default",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --default"
      ],
      "tip": [
        "将所有选项重置为默认值。"
      ]
    },
    {
      "name": "--ditroff",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --ditroff"
      ],
      "tip": [
        "使用 groff 生成 ditroff。"
      ]
    },
    {
      "name": "--encoding",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --encoding=ENCODING"
      ],
      "tip": [
        "使用选定的输出编码。"
      ],
      "next": []
    },
    {
      "name": "--extension",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --extension=EXTENSION"
      ],
      "tip": [
        "将搜索限制为此扩展名。"
      ],
      "next": []
    },
    {
      "name": "--global-apropos",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --global-apropos"
      ],
      "tip": [
        "在所有页中搜索文本。"
      ]
    },
    {
      "name": "--gxditview",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --gxditview[=RESOLUTION]"
      ],
      "tip": [
        "通过 gxditview 显示。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-?"
      ],
      "usage": [
        "-?, --help"
      ],
      "tip": [
        "给出此帮助列表。"
      ]
    },
    {
      "name": "--html",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --html[=BROWSER]"
      ],
      "tip": [
        "使用浏览器显示 HTML 输出。"
      ],
      "next": []
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-case"
      ],
      "tip": [
        "不区分大小写查找页面。"
      ]
    },
    {
      "name": "--local-file",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --local-file"
      ],
      "tip": [
        "将 PAGE 参数解释为本地文件。"
      ]
    },
    {
      "name": "--locale",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --locale=LOCALE"
      ],
      "tip": [
        "为本次搜索定义区域设置。"
      ],
      "next": []
    },
    {
      "name": "--manpath",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --manpath=PATH"
      ],
      "tip": [
        "设置手册页搜索路径。"
      ],
      "next": []
    },
    {
      "name": "--match-case",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --match-case"
      ],
      "tip": [
        "区分大小写查找页面。"
      ]
    },
    {
      "name": "--names-only",
      "tip": [
        "仅匹配页面名称，不匹配描述。"
      ]
    },
    {
      "name": "--no-hyphenation",
      "alias": [
        "--nh"
      ],
      "usage": [
        "--nh, --no-hyphenation"
      ],
      "tip": [
        "关闭断字。"
      ]
    },
    {
      "name": "--no-justification",
      "alias": [
        "--nj"
      ],
      "usage": [
        "--nj, --no-justification"
      ],
      "tip": [
        "关闭两端对齐。"
      ]
    },
    {
      "name": "--no-subpages",
      "tip": [
        "不尝试子页面。"
      ]
    },
    {
      "name": "--pager",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pager=PAGER"
      ],
      "tip": [
        "使用 PAGER 显示输出。"
      ],
      "next": []
    },
    {
      "name": "--preprocessor",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --preprocessor=STRING"
      ],
      "tip": [
        "选择要运行的预处理器（e、p、t、g、r、v）。"
      ],
      "next": []
    },
    {
      "name": "--prompt",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --prompt=STRING"
      ],
      "tip": [
        "为 less 分页器提供提示。"
      ],
      "next": []
    },
    {
      "name": "--recode",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recode=ENCODING"
      ],
      "tip": [
        "以指定编码输出源页。"
      ],
      "next": []
    },
    {
      "name": "--regex",
      "tip": [
        "显示所有匹配正则的页面。"
      ]
    },
    {
      "name": "--sections",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sections=LIST"
      ],
      "tip": [
        "仅搜索这些节（冒号分隔）。"
      ],
      "next": []
    },
    {
      "name": "--systems",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --systems=SYSTEM"
      ],
      "tip": [
        "使用其他系统的手册页。"
      ],
      "next": []
    },
    {
      "name": "--troff",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --troff"
      ],
      "tip": [
        "使用 groff 格式化页面。"
      ]
    },
    {
      "name": "--troff-device",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --troff-device[=DEVICE]"
      ],
      "tip": [
        "使用选定的 groff 设备。"
      ],
      "next": []
    },
    {
      "name": "--update",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --update"
      ],
      "tip": [
        "强制进行缓存一致性检查。"
      ]
    },
    {
      "name": "--usage",
      "tip": [
        "给出简短用法消息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印程序版本。"
      ]
    },
    {
      "name": "--warnings",
      "usage": [
        "--warnings[=WARNINGS]"
      ],
      "tip": [
        "启用 groff 警告。"
      ],
      "next": []
    },
    {
      "name": "--whatis",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --whatis"
      ],
      "tip": [
        "等同于 whatis。"
      ]
    },
    {
      "name": "--where",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --path, --where, --location"
      ],
      "tip": [
        "打印手册页的物理位置。"
      ]
    },
    {
      "name": "--where-cat",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --where-cat, --location-cat"
      ],
      "tip": [
        "打印 cat 文件的物理位置。"
      ]
    },
    {
      "name": "--wildcard",
      "tip": [
        "显示所有匹配通配符的页面。"
      ]
    }
  ]
}
