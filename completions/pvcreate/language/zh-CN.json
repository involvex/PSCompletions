{
  "meta": {
    "url": "https://gitlab.com/lvmteam/lvm2",
    "description": [
      "初始化供 LVM 使用的物理卷"
    ]
  },
  "option": [
    {
      "name": "--bootloaderareasize",
      "usage": [
        "--bootloaderareasize Size[m|UNIT]"
      ],
      "tip": [
        "在 LVM 元数据区和第一个 PE 之间为引导程序预留空间。"
      ],
      "next": []
    },
    {
      "name": "--commandprofile",
      "usage": [
        "--commandprofile String"
      ],
      "tip": [
        "用于命令配置的命令配置。"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config String"
      ],
      "tip": [
        "命令的配置设置。"
      ],
      "next": []
    },
    {
      "name": "--dataalignment",
      "usage": [
        "--dataalignment Size[k|UNIT]"
      ],
      "tip": [
        "将 PV 数据区起点按此数字的倍数对齐。"
      ],
      "next": []
    },
    {
      "name": "--dataalignmentoffset",
      "usage": [
        "--dataalignmentoffset Size[k|UNIT]"
      ],
      "tip": [
        "按此附加偏移移动 PV 数据区的起点。"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "设置调试级别。"
      ],
      "repeat": 6
    },
    {
      "name": "--devices",
      "usage": [
        "--devices PV"
      ],
      "tip": [
        "限制命令可见和可访问的设备。"
      ],
      "repeat": 99,
      "separator": ",",
      "next": []
    },
    {
      "name": "--devicesfile",
      "usage": [
        "--devicesfile String"
      ],
      "tip": [
        "LVM 应使用的设备列表文件。"
      ],
      "next": []
    },
    {
      "name": "--driverloaded",
      "usage": [
        "--driverloaded y|n"
      ],
      "tip": [
        "设为 no 时，命令不会尝试使用 device-mapper。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "覆盖各种检查、确认和保护。"
      ],
      "repeat": 99
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助文本。"
      ]
    },
    {
      "name": "--journal",
      "usage": [
        "--journal String"
      ],
      "tip": [
        "将信息记录到 systemd 日志。"
      ],
      "next": []
    },
    {
      "name": "--labelsector",
      "usage": [
        "--labelsector Number"
      ],
      "tip": [
        "默认在 PV 的第二个扇区（扇区 1）写入 LVM2 标识。"
      ],
      "next": []
    },
    {
      "name": "--lockopt",
      "usage": [
        "--lockopt String"
      ],
      "tip": [
        "用于向 lvmlockd 传递特殊情况选项。"
      ],
      "next": []
    },
    {
      "name": "--longhelp",
      "tip": [
        "显示长帮助文本。"
      ]
    },
    {
      "name": "--metadatacopies",
      "usage": [
        "--metadatacopies 0|1|2"
      ],
      "tip": [
        "在 PV 上为存储 VG 元数据预留的元数据区数量。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--metadataignore",
      "usage": [
        "--metadataignore y|n"
      ],
      "tip": [
        "指定 PV 的 metadataignore 属性。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--metadatasize",
      "usage": [
        "--metadatasize Size[m|UNIT]"
      ],
      "tip": [
        "每个 VG 元数据区使用的近似空间量。"
      ],
      "next": []
    },
    {
      "name": "--metadatatype",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --metadatatype lvm2"
      ],
      "tip": [
        "指定要使用的磁盘元数据类型。"
      ],
      "next": []
    },
    {
      "name": "--nohints",
      "tip": [
        "不使用提示文件定位 PV 的设备。"
      ]
    },
    {
      "name": "--nolocking",
      "tip": [
        "禁用锁定。"
      ]
    },
    {
      "name": "--norestorefile",
      "tip": [
        "与 --uuid 结合使用时，允许指定 uuid 而无需同时提供元数据备份。"
      ]
    },
    {
      "name": "--profile",
      "usage": [
        "--profile String"
      ],
      "tip": [
        "根据命令不同，作为 --commandprofile 或 --metadataprofile 的别名。"
      ],
      "next": []
    },
    {
      "name": "--pvmetadatacopies",
      "usage": [
        "--pvmetadatacopies 0|1|2"
      ],
      "tip": [
        "在 PV 上为存储 VG 元数据预留的元数据区数量。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制输出和日志消息。"
      ],
      "repeat": 99
    },
    {
      "name": "--reportformat",
      "usage": [
        "--reportformat basic|json|json_std"
      ],
      "tip": [
        "覆盖由 lvm.conf(5) 中 report/output_format 全局定义的报告输出格式。"
      ],
      "next": [
        {
          "name": "basic"
        },
        {
          "name": "json"
        },
        {
          "name": "json_std"
        }
      ]
    },
    {
      "name": "--restorefile",
      "usage": [
        "--restorefile String"
      ],
      "tip": [
        "与 --uuid 结合使用时，读取 vgcfgbackup 生成的文件，提取 PV 上数据的位置和大小，并确保程序生成的元数据与文件内容一致，即物理区段位于相同位置且不会被新元数据覆盖。"
      ],
      "next": []
    },
    {
      "name": "--setphysicalvolumesize",
      "usage": [
        "--setphysicalvolumesize Size[m|UNIT]"
      ],
      "tip": [
        "覆盖自动检测的 PV 大小。"
      ],
      "next": []
    },
    {
      "name": "--test",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --test"
      ],
      "tip": [
        "以测试模式运行。"
      ]
    },
    {
      "name": "--uuid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uuid String"
      ],
      "tip": [
        "指定设备的 UUID。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "设置详细级别。"
      ],
      "repeat": 99
    },
    {
      "name": "--version",
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--yes",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yes"
      ],
      "tip": [
        "不进行交互确认，始终假定回答为 yes。"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --zero y|n"
      ],
      "tip": [
        "控制是否擦除设备的前 4 个扇区（2048 字节）。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    }
  ]
}
