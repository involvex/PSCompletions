{
  "meta": {
    "url": "https://github.com/sysstat/sysstat",
    "description": [
      "报告 CPU 和 I/O 统计信息。"
    ]
  },
  "option": [
    {
      "name": "--compact",
      "tip": [
        "使用紧凑输出。"
      ]
    },
    {
      "name": "--dec",
      "usage": [
        "--dec={0|1|2}"
      ],
      "tip": [
        "设置小数精度。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--human",
      "tip": [
        "以人类可读格式打印大小。"
      ]
    },
    {
      "name": "--pretty",
      "tip": [
        "美化 JSON 输出。"
      ]
    },
    {
      "name": "-c",
      "tip": [
        "显示 CPU 利用率。"
      ]
    },
    {
      "name": "-d",
      "tip": [
        "显示设备利用率。"
      ]
    },
    {
      "name": "-f",
      "usage": [
        "-f <directory>"
      ],
      "tip": [
        "为设备映射使用指定目录。"
      ],
      "next": []
    },
    {
      "name": "-g",
      "usage": [
        "-g <group_name>"
      ],
      "tip": [
        "显示设备组统计。"
      ],
      "next": []
    },
    {
      "name": "-h",
      "tip": [
        "以人类可读格式打印大小。"
      ]
    },
    {
      "name": "-H",
      "tip": [
        "以 ISO 格式显示时间戳。"
      ]
    },
    {
      "name": "-j",
      "usage": [
        "-j {ID|LABEL|PATH|UUID|...}"
      ],
      "tip": [
        "显示持久设备名。"
      ],
      "next": [
        {
          "name": "ID"
        },
        {
          "name": "LABEL"
        },
        {
          "name": "PATH"
        },
        {
          "name": "UUID"
        }
      ]
    },
    {
      "name": "-k",
      "tip": [
        "以千字节显示大小。"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "以兆字节显示大小。"
      ]
    },
    {
      "name": "-N",
      "tip": [
        "显示注册的设备映射名。"
      ]
    },
    {
      "name": "-o",
      "usage": [
        "-o JSON"
      ],
      "tip": [
        "以 JSON 格式输出。"
      ],
      "next": [
        {
          "name": "JSON"
        }
      ]
    },
    {
      "name": "-p",
      "usage": [
        "-p [<device> [...]|ALL]"
      ],
      "tip": [
        "显示设备统计。"
      ],
      "next": []
    },
    {
      "name": "-s",
      "tip": [
        "显示简短输出。"
      ]
    },
    {
      "name": "-t",
      "tip": [
        "显示时间戳。"
      ]
    },
    {
      "name": "-V",
      "tip": [
        "打印版本信息。"
      ]
    },
    {
      "name": "-x",
      "tip": [
        "显示扩展统计信息。"
      ]
    },
    {
      "name": "-y",
      "tip": [
        "跳过第一次报告。"
      ]
    },
    {
      "name": "-z",
      "tip": [
        "省略无活动的设备。"
      ]
    },
    {
      "name": "+f",
      "usage": [
        "+f <directory>"
      ],
      "tip": [
        "将目录添加到设备映射搜索路径。"
      ],
      "next": []
    }
  ]
}
