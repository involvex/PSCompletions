{
  "meta": {
    "url": "https://sourceforge.net/projects/net-tools",
    "description": [
      "显示或管理 IP 路由表。"
    ]
  },
  "next": [
    {
      "name": "add",
      "usage": [
        "add [-net|-host] <TARGET> [netmask <NM>] [gw <GW>] [metric <N>] [dev <INTERFACE>]"
      ],
      "tip": [
        "添加新路由。"
      ],
      "option": [
        {
          "name": "-host",
          "tip": [
            "将目标视为主机。"
          ]
        },
        {
          "name": "-net",
          "tip": [
            "将目标视为网络。"
          ]
        },
        {
          "name": "dev",
          "usage": [
            "dev <INTERFACE>"
          ],
          "tip": [
            "将此路由关联到该接口。"
          ],
          "next": []
        },
        {
          "name": "dyn",
          "tip": [
            "安装动态路由。"
          ]
        },
        {
          "name": "gw",
          "usage": [
            "gw <GW>"
          ],
          "tip": [
            "通过此网关路由数据包。"
          ],
          "next": []
        },
        {
          "name": "irtt",
          "usage": [
            "irtt <I>"
          ],
          "tip": [
            "以毫秒设置初始往返时间（1-12000）。"
          ],
          "next": []
        },
        {
          "name": "metric",
          "usage": [
            "metric <M>"
          ],
          "tip": [
            "设置路由的度量值。"
          ],
          "next": []
        },
        {
          "name": "mod",
          "tip": [
            "安装修改过的路由。"
          ]
        },
        {
          "name": "mss",
          "usage": [
            "mss <M>"
          ],
          "tip": [
            "以字节设置路由的 MTU。"
          ],
          "next": []
        },
        {
          "name": "netmask",
          "usage": [
            "netmask <NM>"
          ],
          "tip": [
            "设置网络路由的网络掩码。"
          ],
          "next": []
        },
        {
          "name": "reinstate",
          "tip": [
            "恢复动态路由。"
          ]
        },
        {
          "name": "reject",
          "tip": [
            "安装阻塞路由。"
          ]
        },
        {
          "name": "window",
          "usage": [
            "window <W>"
          ],
          "tip": [
            "设置此路由上连接的 TCP 窗口大小。"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "del",
      "usage": [
        "del [-net|-host] <TARGET> [gw <GW>] [netmask <NM>] [metric <M>] [dev <INTERFACE>]"
      ],
      "tip": [
        "删除路由。"
      ],
      "option": [
        {
          "name": "-host",
          "tip": [
            "将目标视为主机。"
          ]
        },
        {
          "name": "-net",
          "tip": [
            "将目标视为网络。"
          ]
        },
        {
          "name": "dev",
          "usage": [
            "dev <INTERFACE>"
          ],
          "tip": [
            "在该接口上匹配路由。"
          ],
          "next": []
        },
        {
          "name": "gw",
          "usage": [
            "gw <GW>"
          ],
          "tip": [
            "通过此网关路由数据包。"
          ],
          "next": []
        },
        {
          "name": "metric",
          "usage": [
            "metric <M>"
          ],
          "tip": [
            "设置路由的度量值。"
          ],
          "next": []
        },
        {
          "name": "netmask",
          "usage": [
            "netmask <NM>"
          ],
          "tip": [
            "设置网络路由的网络掩码。"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "flush",
      "tip": [
        "清空路由表。"
      ]
    }
  ],
  "option": [
    {
      "name": "--extend",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --extend"
      ],
      "tip": [
        "显示更多信息；使用两次可输出完整长行。"
      ],
      "repeat": 2
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示该地址族的详细用法。"
      ]
    },
    {
      "name": "--numeric",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --numeric"
      ],
      "tip": [
        "显示数字地址，不解析主机名。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-N",
      "tip": [
        "将硬件地址解析为名称。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--cache",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --cache"
      ],
      "tip": [
        "操作路由缓存。"
      ]
    },
    {
      "name": "--fib",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --fib"
      ],
      "tip": [
        "操作 FIB 路由表（默认）。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "输出详细信息。"
      ]
    },
    {
      "name": "-4",
      "tip": [
        "使用 inet（IPv4）地址族。"
      ]
    },
    {
      "name": "-6",
      "tip": [
        "使用 inet6（IPv6）地址族。"
      ]
    },
    {
      "name": "-A",
      "usage": [
        "-A <FAMILY>"
      ],
      "tip": [
        "使用指定的地址族。"
      ],
      "next": [
        {
          "name": "ax25"
        },
        {
          "name": "ddp"
        },
        {
          "name": "inet"
        },
        {
          "name": "inet6"
        },
        {
          "name": "ipx"
        },
        {
          "name": "netrom"
        },
        {
          "name": "rose"
        },
        {
          "name": "x25"
        }
      ]
    }
  ]
}
