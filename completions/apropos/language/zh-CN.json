{
  "meta": {
    "url": "https://gitlab.com/man-db/man-db",
    "description": [
      "搜索手册页名称和描述。"
    ]
  },
  "option": [
    {
      "name": "--and",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --and"
      ],
      "tip": [
        "要求所有关键字都匹配。"
      ]
    },
    {
      "name": "--config-file",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --config-file=FILE"
      ],
      "tip": [
        "使用此用户配置文件。"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "输出调试消息。"
      ]
    },
    {
      "name": "--exact",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exact"
      ],
      "tip": [
        "对每个关键字进行精确匹配。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-?"
      ],
      "usage": [
        "-?, --help"
      ],
      "tip": [
        "给出此帮助列表。"
      ]
    },
    {
      "name": "--locale",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --locale=LOCALE"
      ],
      "tip": [
        "为本次搜索定义区域设置。"
      ],
      "next": []
    },
    {
      "name": "--long",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --long"
      ],
      "tip": [
        "不将输出裁剪到终端宽度。"
      ]
    },
    {
      "name": "--manpath",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --manpath=PATH"
      ],
      "tip": [
        "设置手册页搜索路径。"
      ],
      "next": []
    },
    {
      "name": "--regex",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --regex"
      ],
      "tip": [
        "将每个关键字解释为正则。"
      ]
    },
    {
      "name": "--sections",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sections=LIST"
      ],
      "tip": [
        "仅搜索这些节（冒号分隔）。"
      ],
      "next": []
    },
    {
      "name": "--systems",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --systems=SYSTEM"
      ],
      "tip": [
        "使用其他系统的手册页。"
      ],
      "next": []
    },
    {
      "name": "--usage",
      "tip": [
        "给出简短用法消息。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "打印详细警告消息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印程序版本。"
      ]
    },
    {
      "name": "--wildcard",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wildcard"
      ],
      "tip": [
        "关键字包含通配符。"
      ]
    }
  ]
}
