  "option": [
    {
      "name": "--api-version",
      "usage": [
        "--api-version <VER>"
      ],
      "tip": [
        "Override the API version (e.g., v2, v3)."
      ],
      "next": []
    },
    {
      "name": "--format",
      "usage": [
        "--format <FMT>"
      ],
      "tip": [
        "Output format.",
        "Possible values: csv, json, table, yaml",
        "Default: json."
      ],
      "next": [
        {
          "name": "csv",
          "tip": [
            "CSV output."
          ]
        },
        {
          "name": "json",
          "tip": [
            "JSON output (default)."
          ]
        },
        {
          "name": "table",
          "tip": [
            "Table output."
          ]
        },
        {
          "name": "yaml",
          "tip": [
            "YAML output."
          ]
        }
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json <JSON>"
      ],
      "tip": [
        "Request body as JSON (POST, PATCH, PUT)."
      ],
      "next": []
    },
    {
      "name": "--output",
      "usage": [
        "--output <PATH>"
      ],
      "tip": [
        "Output file path for binary responses."
      ],
      "next": []
    },
    {
      "name": "--page-all",
      "tip": [
        "Auto-paginate, one JSON line per page (NDJSON)."
      ]
    },
    {
      "name": "--page-delay",
      "usage": [
        "--page-delay <MS>"
      ],
      "tip": [
        "Delay between pages in milliseconds with --page-all.",
        "Default: 100."
      ],
      "next": []
    },
    {
      "name": "--page-limit",
      "usage": [
        "--page-limit <N>"
      ],
      "tip": [
        "Maximum pages to fetch with --page-all.",
        "Default: 10."
      ],
      "next": []
    },
    {
      "name": "--params",
      "usage": [
        "--params <JSON>"
      ],
      "tip": [
        "URL or query parameters as JSON."
      ],
      "next": []
    },
    {
      "name": "--upload",
      "usage": [
        "--upload <PATH>"
      ],
      "tip": [
        "Local file to upload as media content (multipart)."
      ],
      "next": []
    },
    {
      "name": "--upload-content-type",
      "usage": [
        "--upload-content-type <MIME>"
      ],
      "tip": [
        "MIME type of the uploaded file.",
        "Auto-detected from extension if omitted."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    }
