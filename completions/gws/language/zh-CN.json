  "option": [
    {
      "name": "--api-version",
      "usage": [
        "--api-version <VER>"
      ],
      "tip": [
        "覆盖 API 版本 (例如 v2、v3)。"
      ],
      "next": []
    },
    {
      "name": "--format",
      "usage": [
        "--format <FMT>"
      ],
      "tip": [
        "输出格式。",
        "可能值: csv, json, table, yaml",
        "默认: json。"
      ],
      "next": [
        {
          "name": "csv",
          "tip": [
            "CSV 输出。"
          ]
        },
        {
          "name": "json",
          "tip": [
            "JSON 输出 (默认)。"
          ]
        },
        {
          "name": "table",
          "tip": [
            "表格输出。"
          ]
        },
        {
          "name": "yaml",
          "tip": [
            "YAML 输出。"
          ]
        }
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json <JSON>"
      ],
      "tip": [
        "以 JSON 形式提供请求正文 (POST、PATCH、PUT)。"
      ],
      "next": []
    },
    {
      "name": "--output",
      "usage": [
        "--output <PATH>"
      ],
      "tip": [
        "二进制响应的输出文件路径。"
      ],
      "next": []
    },
    {
      "name": "--page-all",
      "tip": [
        "自动分页，每页输出一行 JSON (NDJSON)。"
      ]
    },
    {
      "name": "--page-delay",
      "usage": [
        "--page-delay <MS>"
      ],
      "tip": [
        "使用 --page-all 时分页之间的延迟 (毫秒)。",
        "默认: 100。"
      ],
      "next": []
    },
    {
      "name": "--page-limit",
      "usage": [
        "--page-limit <N>"
      ],
      "tip": [
        "使用 --page-all 时获取的最大页数。",
        "默认: 10。"
      ],
      "next": []
    },
    {
      "name": "--params",
      "usage": [
        "--params <JSON>"
      ],
      "tip": [
        "以 JSON 形式提供 URL 或查询参数。"
      ],
      "next": []
    },
    {
      "name": "--upload",
      "usage": [
        "--upload <PATH>"
      ],
      "tip": [
        "作为媒体内容上传的本地文件 (multipart)。"
      ],
      "next": []
    },
    {
      "name": "--upload-content-type",
      "usage": [
        "--upload-content-type <MIME>"
      ],
      "tip": [
        "上传文件的 MIME 类型。",
        "省略时根据扩展名自动检测。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本。"
      ]
