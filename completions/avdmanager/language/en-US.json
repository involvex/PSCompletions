{
  "meta": {
    "url": "https://developer.android.com/studio/run/managing-avds",
    "description": [
      "avdmanager - Android Virtual Device Manager.",
      "Create, manage, and delete Android Virtual Devices (AVDs) for the Android emulator."
    ]
  },
  "next": [
    {
      "name": "create",
      "tip": [
        "Create a new Android Virtual Device."
      ],
      "next": [
        {
          "name": "avd",
          "tip": [
            "Creates a new Android Virtual Device."
          ],
          "option": [
            {
              "name": "--abi",
              "alias": [
                "-b"
              ],
              "usage": [
                "-b, --abi <abi>"
              ],
              "tip": [
                "The ABI to use for the AVD.",
                "Auto-selects if the platform has only one ABI for its system images."
              ],
              "next": []
            },
            {
              "name": "--device",
              "alias": [
                "-d"
              ],
              "usage": [
                "-d, --device <device>"
              ],
              "tip": [
                "The optional device definition to use.",
                "Can be a device index or id."
              ],
              "next": []
            },
            {
              "name": "--force",
              "alias": [
                "-f"
              ],
              "usage": [
                "-f, --force"
              ],
              "tip": [
                "Forces creation (overwrites an existing AVD)."
              ]
            },
            {
              "name": "--name",
              "alias": [
                "-n"
              ],
              "usage": [
                "-n, --name <name>"
              ],
              "tip": [
                "Name of the new AVD. [required]"
              ],
              "next": []
            },
            {
              "name": "--package",
              "alias": [
                "-k"
              ],
              "usage": [
                "-k, --package <package>"
              ],
              "tip": [
                "Package path of the system image for this AVD.",
                "Example: -k 'system-images;android-35;google_apis;x86_64'"
              ],
              "next": []
            },
            {
              "name": "--path",
              "alias": [
                "-p"
              ],
              "usage": [
                "-p, --path <path>"
              ],
              "tip": [
                "Directory where the new AVD will be created."
              ],
              "next": []
            },
            {
              "name": "--sdcard",
              "alias": [
                "-c"
              ],
              "usage": [
                "-c, --sdcard <path|size>"
              ],
              "tip": [
                "Path to a shared SD card image, or size of a new sdcard for the new AVD.",
                "Example: -c 512M"
              ],
              "next": []
            },
            {
              "name": "--skin",
              "usage": [
                "--skin <skin>"
              ],
              "tip": [
                "The optional name of a skin to use with this device."
              ],
              "next": []
            },
            {
              "name": "--tag",
              "alias": [
                "-g"
              ],
              "usage": [
                "-g, --tag <tag>"
              ],
              "tip": [
                "The sys-img tag to use for the AVD.",
                "Auto-selects if the platform has only one tag for its system images."
              ],
              "next": []
            }
          ]
        }
      ]
    },
    {
      "name": "delete",
      "tip": [
        "Delete an Android Virtual Device."
      ],
      "next": [
        {
          "name": "avd",
          "tip": [
            "Deletes an Android Virtual Device."
          ],
          "option": [
            {
              "name": "--name",
              "alias": [
                "-n"
              ],
              "usage": [
                "-n, --name <name>"
              ],
              "tip": [
                "Name of the AVD to delete. [required]"
              ],
              "next": []
            }
          ]
        }
      ]
    },
    {
      "name": "list",
      "tip": [
        "Lists existing targets or virtual devices."
      ],
      "next": [
        {
          "name": "avd",
          "tip": [
            "Lists existing Android Virtual Devices."
          ],
          "option": [
            {
              "name": "--compact",
              "alias": [
                "-c"
              ],
              "usage": [
                "-c, --compact"
              ],
              "tip": [
                "Compact output (suitable for scripts)."
              ]
            },
            {
              "name": "--null",
              "alias": [
                "-0"
              ],
              "usage": [
                "-0, --null"
              ],
              "tip": [
                "Terminates lines with \\0 instead of \\n (e.g. for xargs -0).",
                "Only used by --compact."
              ]
            }
          ]
        },
        {
          "name": "device",
          "tip": [
            "Lists existing devices."
          ],
          "option": [
            {
              "name": "--compact",
              "alias": [
                "-c"
              ],
              "usage": [
                "-c, --compact"
              ],
              "tip": [
                "Compact output (suitable for scripts)."
              ]
            },
            {
              "name": "--null",
              "alias": [
                "-0"
              ],
              "usage": [
                "-0, --null"
              ],
              "tip": [
                "Terminates lines with \\0 instead of \\n (e.g. for xargs -0).",
                "Only used by --compact."
              ]
            }
          ]
        },
        {
          "name": "target",
          "tip": [
            "Lists existing targets."
          ],
          "option": [
            {
              "name": "--compact",
              "alias": [
                "-c"
              ],
              "usage": [
                "-c, --compact"
              ],
              "tip": [
                "Compact output (suitable for scripts)."
              ]
            },
            {
              "name": "--null",
              "alias": [
                "-0"
              ],
              "usage": [
                "-0, --null"
              ],
              "tip": [
                "Terminates lines with \\0 instead of \\n (e.g. for xargs -0).",
                "Only used by --compact."
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "move",
      "tip": [
        "Move or rename an Android Virtual Device."
      ],
      "next": [
        {
          "name": "avd",
          "tip": [
            "Moves or renames an Android Virtual Device."
          ],
          "option": [
            {
              "name": "--name",
              "alias": [
                "-n"
              ],
              "usage": [
                "-n, --name <name>"
              ],
              "tip": [
                "Name of the AVD to move or rename. [required]"
              ],
              "next": []
            },
            {
              "name": "--path",
              "alias": [
                "-p"
              ],
              "usage": [
                "-p, --path <path>"
              ],
              "tip": [
                "Path to the AVD's new directory."
              ],
              "next": []
            },
            {
              "name": "--rename",
              "alias": [
                "-r"
              ],
              "usage": [
                "-r, --rename <new_name>"
              ],
              "tip": [
                "New name of the AVD."
              ],
              "next": []
            }
          ]
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--clear-cache",
      "tip": [
        "Clear the SDK Manager repository manifest cache."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Help on a specific command."
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --silent"
      ],
      "tip": [
        "Silent mode, shows errors only."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Verbose mode, shows errors, warnings and all messages."
      ]
    }
  ]
}
