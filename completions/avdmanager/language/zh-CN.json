{
  "meta": {
    "url": "https://developer.android.com/studio/run/managing-avds",
    "description": [
      "avdmanager - Android 虚拟设备管理器。",
      "创建、管理和删除 Android 模拟器的虚拟设备 (AVD)。"
    ]
  },
  "next": [
    {
      "name": "create",
      "tip": [
        "创建一个新的 Android 虚拟设备。"
      ],
      "next": [
        {
          "name": "avd",
          "tip": [
            "创建一个新的 Android 虚拟设备。"
          ],
          "option": [
            {
              "name": "--abi",
              "alias": [
                "-b"
              ],
              "usage": [
                "-b, --abi <abi>"
              ],
              "tip": [
                "用于 AVD 的 ABI。",
                "如果平台的系统镜像只有一个 ABI，则自动选择。"
              ],
              "next": []
            },
            {
              "name": "--device",
              "alias": [
                "-d"
              ],
              "usage": [
                "-d, --device <device>"
              ],
              "tip": [
                "可选的设备定义。",
                "可以是设备索引或 ID。"
              ],
              "next": []
            },
            {
              "name": "--force",
              "alias": [
                "-f"
              ],
              "usage": [
                "-f, --force"
              ],
              "tip": [
                "强制创建（覆盖已有的 AVD）。"
              ]
            },
            {
              "name": "--name",
              "alias": [
                "-n"
              ],
              "usage": [
                "-n, --name <name>"
              ],
              "tip": [
                "新 AVD 的名称。[必填]"
              ],
              "next": []
            },
            {
              "name": "--package",
              "alias": [
                "-k"
              ],
              "usage": [
                "-k, --package <package>"
              ],
              "tip": [
                "此 AVD 的系统镜像包路径。",
                "示例: -k 'system-images;android-35;google_apis;x86_64'"
              ],
              "next": []
            },
            {
              "name": "--path",
              "alias": [
                "-p"
              ],
              "usage": [
                "-p, --path <path>"
              ],
              "tip": [
                "新 AVD 的创建目录。"
              ],
              "next": []
            },
            {
              "name": "--sdcard",
              "alias": [
                "-c"
              ],
              "usage": [
                "-c, --sdcard <path|size>"
              ],
              "tip": [
                "共享 SD 卡镜像的路径，或新 SD 卡的大小。",
                "示例: -c 512M"
              ],
              "next": []
            },
            {
              "name": "--skin",
              "usage": [
                "--skin <skin>"
              ],
              "tip": [
                "可选的皮肤名称。"
              ],
              "next": []
            },
            {
              "name": "--tag",
              "alias": [
                "-g"
              ],
              "usage": [
                "-g, --tag <tag>"
              ],
              "tip": [
                "用于 AVD 的系统镜像标签。",
                "如果平台的系统镜像只有一个标签，则自动选择。"
              ],
              "next": []
            }
          ]
        }
      ]
    },
    {
      "name": "delete",
      "tip": [
        "删除一个 Android 虚拟设备。"
      ],
      "next": [
        {
          "name": "avd",
          "tip": [
            "删除一个 Android 虚拟设备。"
          ],
          "option": [
            {
              "name": "--name",
              "alias": [
                "-n"
              ],
              "usage": [
                "-n, --name <name>"
              ],
              "tip": [
                "要删除的 AVD 名称。[必填]"
              ],
              "next": []
            }
          ]
        }
      ]
    },
    {
      "name": "list",
      "tip": [
        "列出已有的目标或虚拟设备。"
      ],
      "next": [
        {
          "name": "avd",
          "tip": [
            "列出已有的 Android 虚拟设备。"
          ],
          "option": [
            {
              "name": "--compact",
              "alias": [
                "-c"
              ],
              "usage": [
                "-c, --compact"
              ],
              "tip": [
                "紧凑输出（适用于脚本）。"
              ]
            },
            {
              "name": "--null",
              "alias": [
                "-0"
              ],
              "usage": [
                "-0, --null"
              ],
              "tip": [
                "使用 \\0 而不是 \\n 终止行（例如用于 xargs -0）。",
                "仅在 --compact 时使用。"
              ]
            }
          ]
        },
        {
          "name": "device",
          "tip": [
            "列出已有的设备定义。"
          ],
          "option": [
            {
              "name": "--compact",
              "alias": [
                "-c"
              ],
              "usage": [
                "-c, --compact"
              ],
              "tip": [
                "紧凑输出（适用于脚本）。"
              ]
            },
            {
              "name": "--null",
              "alias": [
                "-0"
              ],
              "usage": [
                "-0, --null"
              ],
              "tip": [
                "使用 \\0 而不是 \\n 终止行（例如用于 xargs -0）。",
                "仅在 --compact 时使用。"
              ]
            }
          ]
        },
        {
          "name": "target",
          "tip": [
            "列出已有的目标。"
          ],
          "option": [
            {
              "name": "--compact",
              "alias": [
                "-c"
              ],
              "usage": [
                "-c, --compact"
              ],
              "tip": [
                "紧凑输出（适用于脚本）。"
              ]
            },
            {
              "name": "--null",
              "alias": [
                "-0"
              ],
              "usage": [
                "-0, --null"
              ],
              "tip": [
                "使用 \\0 而不是 \\n 终止行（例如用于 xargs -0）。",
                "仅在 --compact 时使用。"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "move",
      "tip": [
        "移动或重命名一个 Android 虚拟设备。"
      ],
      "next": [
        {
          "name": "avd",
          "tip": [
            "移动或重命名一个 Android 虚拟设备。"
          ],
          "option": [
            {
              "name": "--name",
              "alias": [
                "-n"
              ],
              "usage": [
                "-n, --name <name>"
              ],
              "tip": [
                "要移动或重命名的 AVD 名称。[必填]"
              ],
              "next": []
            },
            {
              "name": "--path",
              "alias": [
                "-p"
              ],
              "usage": [
                "-p, --path <path>"
              ],
              "tip": [
                "AVD 的新目录路径。"
              ],
              "next": []
            },
            {
              "name": "--rename",
              "alias": [
                "-r"
              ],
              "usage": [
                "-r, --rename <new_name>"
              ],
              "tip": [
                "AVD 的新名称。"
              ],
              "next": []
            }
          ]
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--clear-cache",
      "tip": [
        "清除 SDK Manager 仓库清单缓存。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示特定命令的帮助信息。"
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --silent"
      ],
      "tip": [
        "静默模式，仅显示错误信息。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细模式，显示错误、警告和所有信息。"
      ]
    }
  ]
}
