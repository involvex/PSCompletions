{
  "meta": {
    "url": "https://gitlab.com/procps-ng/procps",
    "description": [
      "Tell how long the system has been running."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help and exit."
      ]
    },
    {
      "name": "--pretty",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pretty"
      ],
      "tip": [
        "Show uptime in pretty format."
      ]
    },
    {
      "name": "--since",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --since"
      ],
      "tip": [
        "Show the system up since time."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Output version information and exit."
      ]
    }
  ]
}
