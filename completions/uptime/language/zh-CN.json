{
  "meta": {
    "url": "https://gitlab.com/procps-ng/procps",
    "description": [
      "显示系统已运行多长时间。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助并退出。"
      ]
    },
    {
      "name": "--pretty",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pretty"
      ],
      "tip": [
        "以易读格式显示运行时间。"
      ]
    },
    {
      "name": "--since",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --since"
      ],
      "tip": [
        "显示系统启动时间。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "输出版本信息并退出。"
      ]
    }
  ]
}
