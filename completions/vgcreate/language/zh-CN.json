{
  "meta": {
    "url": "https://gitlab.com/lvmteam/lvm2",
    "description": [
      "创建卷组"
    ]
  },
  "option": [
    {
      "name": "--addtag",
      "usage": [
        "--addtag Tag"
      ],
      "tip": [
        "为 PV、VG 或 LV 添加标签。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--alloc",
      "usage": [
        "--alloc contiguous|cling|cling_by_tags|normal|anywhere|inherit"
      ],
      "tip": [
        "决定命令从 VG 分配物理区段（PE）时使用的分配策略。"
      ],
      "next": [
        {
          "name": "anywhere"
        },
        {
          "name": "cling"
        },
        {
          "name": "cling_by_tags"
        },
        {
          "name": "contiguous"
        },
        {
          "name": "inherit"
        },
        {
          "name": "normal"
        }
      ]
    },
    {
      "name": "--autobackup",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --autobackup y|n"
      ],
      "tip": [
        "指定更改后是否自动备份元数据。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--clustered",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --clustered y|n"
      ],
      "tip": [
        "此选项曾专用于 clvm，现在由 lvmlockd(8) 的 --shared 选项取代。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--commandprofile",
      "usage": [
        "--commandprofile String"
      ],
      "tip": [
        "用于命令配置的命令配置。"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config String"
      ],
      "tip": [
        "命令的配置设置。"
      ],
      "next": []
    },
    {
      "name": "--dataalignment",
      "usage": [
        "--dataalignment Size[k|UNIT]"
      ],
      "tip": [
        "将 PV 数据区起点按此数字的倍数对齐。"
      ],
      "next": []
    },
    {
      "name": "--dataalignmentoffset",
      "usage": [
        "--dataalignmentoffset Size[k|UNIT]"
      ],
      "tip": [
        "按此附加偏移移动 PV 数据区的起点。"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "设置调试级别。"
      ],
      "repeat": 6
    },
    {
      "name": "--devices",
      "usage": [
        "--devices PV"
      ],
      "tip": [
        "限制命令可见和可访问的设备。"
      ],
      "repeat": 99,
      "separator": ",",
      "next": []
    },
    {
      "name": "--devicesfile",
      "usage": [
        "--devicesfile String"
      ],
      "tip": [
        "LVM 应使用的设备列表文件。"
      ],
      "next": []
    },
    {
      "name": "--driverloaded",
      "usage": [
        "--driverloaded y|n"
      ],
      "tip": [
        "设为 no 时，命令不会尝试使用 device-mapper。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "覆盖各种检查、确认和保护。"
      ],
      "repeat": 99
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助文本。"
      ]
    },
    {
      "name": "--journal",
      "usage": [
        "--journal String"
      ],
      "tip": [
        "将信息记录到 systemd 日志。"
      ],
      "next": []
    },
    {
      "name": "--labelsector",
      "usage": [
        "--labelsector Number"
      ],
      "tip": [
        "默认在 PV 的第二个扇区（扇区 1）写入 LVM2 标识。"
      ],
      "next": []
    },
    {
      "name": "--lockopt",
      "usage": [
        "--lockopt String"
      ],
      "tip": [
        "用于向 lvmlockd 传递特殊情况选项。"
      ],
      "next": []
    },
    {
      "name": "--locktype",
      "usage": [
        "--locktype sanlock|dlm|none"
      ],
      "tip": [
        "直接指定 VG 锁类型，而不使用 --shared。"
      ],
      "next": [
        {
          "name": "dlm"
        },
        {
          "name": "none"
        },
        {
          "name": "sanlock"
        }
      ]
    },
    {
      "name": "--longhelp",
      "tip": [
        "显示长帮助文本。"
      ]
    },
    {
      "name": "--maxlogicalvolumes",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --maxlogicalvolumes Number"
      ],
      "tip": [
        "设置 VG 中允许的最大 LV 数。"
      ],
      "next": []
    },
    {
      "name": "--maxphysicalvolumes",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --maxphysicalvolumes Number"
      ],
      "tip": [
        "设置可属于该 VG 的最大 PV 数。"
      ],
      "next": []
    },
    {
      "name": "--metadatacopies",
      "usage": [
        "--metadatacopies all|unmanaged|Number"
      ],
      "tip": [
        "保留的 VG 元数据副本数。"
      ],
      "next": []
    },
    {
      "name": "--metadataprofile",
      "usage": [
        "--metadataprofile String"
      ],
      "tip": [
        "用于命令配置的元数据配置。"
      ],
      "next": []
    },
    {
      "name": "--metadatasize",
      "usage": [
        "--metadatasize Size[m|UNIT]"
      ],
      "tip": [
        "每个 VG 元数据区使用的近似空间量。"
      ],
      "next": []
    },
    {
      "name": "--metadatatype",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --metadatatype lvm2"
      ],
      "tip": [
        "指定要使用的磁盘元数据类型。"
      ],
      "next": []
    },
    {
      "name": "--nohints",
      "tip": [
        "不使用提示文件定位 PV 的设备。"
      ]
    },
    {
      "name": "--nolocking",
      "tip": [
        "禁用锁定。"
      ]
    },
    {
      "name": "--physicalextentsize",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --physicalextentsize Size[m|UNIT]"
      ],
      "tip": [
        "设置 VG 中 PV 的物理区段大小。"
      ],
      "next": []
    },
    {
      "name": "--profile",
      "usage": [
        "--profile String"
      ],
      "tip": [
        "根据命令不同，作为 --commandprofile 或 --metadataprofile 的别名。"
      ],
      "next": []
    },
    {
      "name": "--pvmetadatacopies",
      "usage": [
        "--pvmetadatacopies 0|1|2"
      ],
      "tip": [
        "在 PV 上为存储 VG 元数据预留的元数据区数量。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制输出和日志消息。"
      ],
      "repeat": 99
    },
    {
      "name": "--reportformat",
      "usage": [
        "--reportformat basic|json|json_std"
      ],
      "tip": [
        "覆盖由 lvm.conf(5) 中 report/output_format 全局定义的报告输出格式。"
      ],
      "next": [
        {
          "name": "basic"
        },
        {
          "name": "json"
        },
        {
          "name": "json_std"
        }
      ]
    },
    {
      "name": "--setautoactivation",
      "usage": [
        "--setautoactivation y|n"
      ],
      "tip": [
        "设置 VG 或 LV 的自动激活属性。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    },
    {
      "name": "--shared",
      "tip": [
        "如果 LVM 编译了 lockd 支持，则使用 lvmlockd 创建共享 VG。"
      ]
    },
    {
      "name": "--systemid",
      "usage": [
        "--systemid String"
      ],
      "tip": [
        "指定赋予新 VG 的系统 ID，覆盖运行命令的主机的系统 ID。"
      ],
      "next": []
    },
    {
      "name": "--test",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --test"
      ],
      "tip": [
        "以测试模式运行。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "设置详细级别。"
      ],
      "repeat": 99
    },
    {
      "name": "--version",
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--vgmetadatacopies",
      "usage": [
        "--vgmetadatacopies all|unmanaged|Number"
      ],
      "tip": [
        "保留的 VG 元数据副本数。"
      ],
      "next": []
    },
    {
      "name": "--yes",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yes"
      ],
      "tip": [
        "不进行交互确认，始终假定回答为 yes。"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --zero y|n"
      ],
      "tip": [
        "控制是否擦除设备的前 4 个扇区（2048 字节）。"
      ],
      "next": [
        {
          "name": "n"
        },
        {
          "name": "y"
        }
      ]
    }
  ]
}
