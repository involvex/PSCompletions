        {
          "name": "p"
        },
        {
          "name": "t"
        }
      ]
    },
    {
      "name": "--scale-task-mem",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --scale-task-mem =SCALE"
      ],
      "tip": [
        "设置任务内存缩放单位：k、m、g、t 或 p。"
      ],
      "next": [
        {
          "name": "g"
