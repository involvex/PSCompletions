        {
          "name": "t"
        }
      ]
    },
    {
      "name": "--secure-mode",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --secure-mode"
      ],
      "tip": [
        "以安全模式限制运行。"
      ]
    },
    {
      "name": "--single-cpu-toggle",
      "alias": [
        "-1"
      ],
      "usage": [
        "-1, --single-cpu-toggle"
      ],
      "tip": [
        "反转上次记住的单 CPU 状态。"
      ]
