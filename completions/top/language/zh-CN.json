{
  "meta": {
    "url": "https://gitlab.com/procps-ng/procps",
    "description": [
      "显示 Linux 进程。"
    ]
  },
  "option": [
    {
      "name": "--accum-time-toggle",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --accum-time-toggle"
      ],
      "tip": [
        "反转上次记住的累计时间状态。"
      ]
    },
    {
      "name": "--batch-mode",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --batch-mode"
      ],
      "tip": [
        "以非交互批处理模式运行。"
      ]
    },
    {
      "name": "--cmdline-toggle",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cmdline-toggle"
      ],
      "tip": [
        "反转上次记住的命令行显示状态。"
      ]
    },
    {
      "name": "--delay",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delay =SECS [.TENTHS]"
      ],
      "tip": [
        "设置迭代延迟（秒和十分之一秒）。"
      ],
      "next": []
    },
    {
      "name": "--filter-any-user",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --filter-any-user =USER"
      ],
      "tip": [
        "仅显示属于 USER 的进程。"
      ],
      "next": []
    },
    {
      "name": "--filter-only-euser",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --filter-only-euser =USER"
      ],
      "tip": [
        "仅显示有效用户为 USER 的进程。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助并退出。"
      ]
    },
    {
      "name": "--idle-toggle",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --idle-toggle"
      ],
      "tip": [
        "反转上次记住的空闲显示状态。"
      ]
    },
    {
      "name": "--iterations",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --iterations =NUMBER"
      ],
      "tip": [
        "达到指定迭代次数后退出。"
      ],
      "next": []
    },
    {
      "name": "--list-fields",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --list-fields"
      ],
      "tip": [
        "输出所有字段名后退出。"
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid =PIDLIST"
      ],
      "tip": [
        "仅监视 PIDLIST 中的任务。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--scale-summary-mem",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --scale-summary-mem =SCALE"
      ],
      "tip": [
        "设置内存缩放单位：k、m、g、t、p 或 e。"
      ],
      "next": [
        {
          "name": "e"
        },
        {
          "name": "g"
        },
        {
          "name": "k"
        },
        {
          "name": "m"
