{
  "meta": {
    "url": "https://sourceforge.net/projects/net-tools",
    "description": [
      "创建和管理 IP 隧道。"
    ]
  },
  "next": [
    {
      "name": "add",
      "usage": [
        "add [<NAME>] [mode <PROTOCOL>] [remote <ADDRESS>] [local <ADDRESS>] [dev <PHYS_DEV>]"
      ],
      "tip": [
        "添加 IP 隧道。"
      ],
      "option": [
        {
          "name": "dev",
          "usage": [
            "dev <INTERFACE>"
          ],
          "tip": [
            "网络接口名。"
          ],
          "next": []
        },
        {
          "name": "icsum",
          "tip": [
            "要求所有传入数据包的校验和正确（仅 GRE）。"
          ]
        },
        {
          "name": "ikey",
          "usage": [
            "ikey <KEY>"
          ],
          "tip": [
            "设置 GRE 隧道的输入密钥。"
          ],
          "next": []
        },
        {
          "name": "iseq",
          "tip": [
            "要求所有传入数据包串行化（仅 GRE）。"
