{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "交互式提升权限。"
    ]
  },
  "option": [
    {
      "name": "--background",
      "usage": [
        "--background=COLOR"
      ],
      "tip": [
        "设置 ANSI 背景色。"
      ],
      "next": []
    },
    {
      "name": "--chdir",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --chdir=PATH"
      ],
      "tip": [
        "设置工作目录。"
      ],
      "next": []
    },
    {
      "name": "--description",
      "usage": [
        "--description=TEXT"
      ],
      "tip": [
        "设置单元描述。"
      ],
      "next": []
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group=GROUP"
      ],
      "tip": [
        "以指定系统组运行。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--machine",
      "usage": [
        "--machine=CONTAINER"
      ],
      "tip": [
        "对本机容器操作。"
      ],
      "next": []
    },
    {
      "name": "--nice",
      "usage": [
        "--nice=NICE"
      ],
      "tip": [
        "设置 nice 级别。"
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不提示输入密码。"
      ]
    },
    {
      "name": "--pipe",
      "tip": [
        "为标准输入输出请求直接管道。"
      ]
    },
    {
      "name": "--property",
      "usage": [
        "--property=NAME=VALUE"
      ],
      "tip": [
        "设置服务或作用域单元属性。"
      ],
      "next": []
    },
    {
      "name": "--pty",
      "tip": [
        "为标准输入输出请求伪终端。"
      ]
    },
    {
      "name": "--setenv",
      "usage": [
        "--setenv=NAME[=VALUE]"
      ],
      "tip": [
        "设置环境变量。"
      ],
      "next": []
    },
    {
      "name": "--shell-prompt-prefix",
      "usage": [
        "--shell-prompt-prefix=PREFIX"
      ],
      "tip": [
        "设置 $SHELL_PROMPT_PREFIX。"
      ],
      "next": []
    },
    {
      "name": "--slice",
      "usage": [
        "--slice=SLICE"
      ],
      "tip": [
        "在指定切片中运行。"
      ],
      "next": []
    },
    {
      "name": "--slice-inherit",
      "tip": [
        "继承切片。"
      ]
    },
    {
      "name": "--unit",
      "usage": [
        "--unit=UNIT"
      ],
      "tip": [
        "在指定单元名下运行。"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user=USER"
      ],
      "tip": [
        "以指定系统用户运行。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示软件包版本。"
      ]
    }
  ]
}
